// ─── Auth.js / User ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  /** Pending e-mail change — applied only after verification. */
  pendingEmail  String?
  role          Role      @default(USER)
  accountStatus UserAccountStatus @default(ACTIVE)
  suspendedAt   DateTime?
  suspendedReason String? @db.Text
  suspendedByUserId String?
  deletionRequestedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  financialProfile      FinancialProfile?
  marketProfiles        UserMarketProfile[]
  propertyPreference    PropertyPreference?
  investmentPreference  InvestmentPreference?
  consents              Consent[]
  consentRecords        ConsentRecord[]
  privacyExportTokens   PrivacyExportToken[]
  favourites            Favourite[]
  favouriteCollections  FavouriteCollection[]
  watchedLocations      WatchedLocation[]
  comparisons           Comparison[]
  comparisonSharesCreated ComparisonShare[] @relation("ComparisonShareCreator")
  comparisonShareInvites  ComparisonShareInvite[]
  savedSearches         SavedSearch[]
  alertSubscriptions    PropertyAlertSubscription[]
  propertyAlerts        PropertyAlert[]
  analyses              PropertyAnalysis[]
  leads                 Lead[]
  inquiries             Inquiry[]                    @relation("InquiryBuyer")
  inquiriesAsAgent      Inquiry[]                    @relation("InquiryAgent")
  qualifiedBuyerLeads   QualifiedBuyerLead[]         @relation("QualifiedBuyer")
  qualifiedBuyerLeadsAsAgent QualifiedBuyerLead[]    @relation("QualifiedBuyerAgent")
  orders                Order[]
  entitlements          Entitlement[]
  manualEntitlementsGranted Entitlement[] @relation("ManualEntitlementActor")
  usageRecords          UsageRecord[]
  promoRedemptions      PromoRedemption[]
  promotionRedemptions  PromotionRedemption[]
  notifications         Notification[]
  auditLogs               AuditLog[]                   @relation("AuditActor")
  configUpdates           AppConfiguration[]           @relation("ConfigUpdater")
  reviewedDuplicates      PropertyDuplicateCandidate[] @relation("DuplicateReviewer")
  fieldOverridesCreated   PropertyFieldOverride[]      @relation("FieldOverrideCreator")
  fieldOverridesUpdated   PropertyFieldOverride[]      @relation("FieldOverrideUpdater")
  ownedProperties         Property[]                   @relation("PropertyOwner")
  listedProperties        Property[]                   @relation("PropertyListedBy")
  organizationMemberships OrganizationMember[]
  organizationPlanChanges OrganizationPlanChange[]     @relation("OrgPlanChangeActor")
  listingBoostsPurchased  ListingBoost[]               @relation("ListingBoostPurchaser")
  successFeesVerified     SuccessFeeRecord[]           @relation("SuccessFeeVerifier")
  leadDisputesOpened      LeadDispute[]                @relation("LeadDisputeOpener")
  leadDisputesResolved    LeadDispute[]                @relation("LeadDisputeResolver")
  professionalServiceRequests ProfessionalServiceRequest[] @relation("ProfessionalServiceRequester")
  professionalServicesAssigned ProfessionalServiceRequest[] @relation("ProfessionalServiceAssignee")
  propertyTransactionsAsBuyer PropertyTransaction[]    @relation("PropertyTransactionBuyer")
  propertyTransactionsAsAgent PropertyTransaction[]    @relation("PropertyTransactionAgent")
  valuationsCreated       Valuation[]                  @relation("ValuationCreator")
  valuationAdjustments    ValuationAdjustmentAudit[]   @relation("ValuationAdjustmentActor")
  ownedAnalysisScenarios  AnalysisScenario[]           @relation("AnalysisScenarioOwner")
  reviewedAnalysisScenarios AnalysisScenario[]         @relation("AnalysisScenarioReviewer")
  approvedAnalysisScenarios AnalysisScenario[]         @relation("AnalysisScenarioApprover")
  ownedMortgageLeadCrm      MortgageLeadCrm[]          @relation("MortgageLeadCrmOwner")
  assignedMortgageLeadCrm   MortgageLeadCrm[]          @relation("MortgageLeadCrmAssignee")
  leadAssignments           LeadAssignment[]           @relation("LeadAssignmentUser")
  leadAssignmentsCreated    LeadAssignment[]           @relation("LeadAssignmentCreator")
  leadActivitiesAuthored    LeadActivity[]             @relation("LeadActivityActor")
  leadsAssigned             Lead[]                     @relation("LeadAssignee")
  leadsOwned                Lead[]                     @relation("LeadOwner")
  leadNextActionsOwned      Lead[]                     @relation("LeadNextActionOwner")
  propertyUserNotes         PropertyUserNote[]
  propertyDecisionTasks     PropertyDecisionTask[]
  decisionPreference        DecisionPreference?
  listingReports            ListingReport[]            @relation("ListingReportReporter")
  listingReportsReviewed    ListingReport[]            @relation("ListingReportReviewer")
  marketplaceModeInterests  MarketplaceModeInterest[]  @relation("MarketplaceModeInterestUser")
  auctionBids               AuctionBid[]               @relation("AuctionBidUser")
  successFeeEngagements     SuccessFeeEngagement[]     @relation("SuccessFeeEngagementUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  phone                  String?
  preferredLocale        String    @default("cs")
  investmentGoal         String?
  /** Onboarding goal: OWN_HOME | INVESTMENT | RENOVATION | FLIP | EXPLORING */
  onboardingGoal         String?
  onboardingStep         Int       @default(1)
  onboardingCompletedAt  DateTime?
  onboardingSkippedAt    DateTime?
  notes                  String?   @db.Text
  /** Transactional alerts (orders, security). Defaults on — not marketing. */
  notifyTransactionalEmail Boolean @default(true)
  notifyTransactionalInApp Boolean @default(true)
  /** Marketing — must default false; never pre-checked in UI. */
  notifyMarketingEmail     Boolean @default(false)
  notifyMarketingInApp     Boolean @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Extremely protected admin impersonation — banner + no payment actions + full audit.
 */
model AdminImpersonationSession {
  id                 String    @id @default(cuid())
  actorUserId        String
  targetUserId       String
  reason             String    @db.Text
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  /** Opaque cookie token hash. */
  tokenHash          String    @unique
  createdAt          DateTime  @default(now())

  @@index([actorUserId, endedAt])
  @@index([targetUserId, endedAt])
}

model FinancialProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  monthlyIncomeCzk      Int?
  monthlyLiabilitiesCzk Int?
  availableEquityCzk    Int?
  /** Optional share of purchase price as own funds (0–100). */
  equityPercent         Float?
  /** MORTGAGE | MIXED | CASH */
  financingMode         String?
  employmentType        String?
  creditScoreBand       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Per-market user preferences (Prompt 17.5).
 * Complements global UserProfile / CZK FinancialProfile — money is currency-tagged.
 */
model UserMarketProfile {
  id                      String   @id @default(cuid())
  userId                  String
  marketCode              String
  preferredLocale         String
  preferredCurrency       String
  goal                    String?
  preferredLocationSlugs  String[] @default([])
  maxBudgetMinor          BigInt?
  availableEquityMinor    BigInt?
  monthlyIncomeMinor      BigInt?
  monthlyLiabilitiesMinor BigInt?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketCode])
  @@index([marketCode])
