// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  PAID_CLIENT
  ANALYST
  SALES
  EDITOR
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  RENTED
  /** Listing no longer confirmed by source — not necessarily sold. */
  UNAVAILABLE
  WITHDRAWN
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OTHER
}

enum PropertyVisibility {
  PUBLIC
  PRIVATE
  ACCOUNT_ONLY
}

enum AddressPrecision {
  EXACT
  APPROXIMATE
  HIDDEN
}

enum TransactionType {
  SALE
  RENT
}

enum PropertyCondition {
  NEW
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_RENOVATION
  SHELL
  UNKNOWN
}

enum ConstructionType {
  BRICK
  PANEL
  WOOD
  STEEL
  MIXED
  OTHER
  UNKNOWN
}

enum OwnershipType {
  PERSONAL
  COOPERATIVE
  MUNICIPAL
  COMPANY
  OTHER
  UNKNOWN
}

enum EnergyRating {
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum PropertyAttributeValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum PropertySourceType {
  MANUAL
  PARTNER_FEED
  LICENSED_API
  PUBLIC_PORTAL
  USER_SUBMITTED
  OTHER
}

enum LicenseStatus {
  UNKNOWN
  OWNED
  LICENSED
  PUBLIC_DOMAIN
  RESTRICTED
  PROHIBITED
}

enum PriceChangeType {
  INITIAL
  INCREASED
  DECREASED
  CORRECTED
  REMOVED
}

enum PropertyMediaType {
  PHOTO
  FLOORPLAN
  DOCUMENT
  VIDEO
  OTHER
}

enum PropertyFreshness {
  FRESH
  STALE
  UNAVAILABLE
}

enum DuplicateCandidateStatus {
  PENDING
  MERGED
  NOT_DUPLICATE
}

enum DataQualitySeverity {
  CRITICAL
  WARNING
  INFO
}

enum DataQualityIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum ImportJobItemStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
  DUPLICATE
}

enum AnalysisTier {
  BASIC
  FULL
}

enum AnalysisStatus {
  DRAFT
  READY
  PURCHASED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LeadType {
  ANALYSIS_INTEREST
  FINANCING
  TRANSACTION
  PARTNER_SERVICE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  HANDED_OFF
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  HYPOTEKAJASNE_HANDOFF
  PARTNER_SHARE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum SavedSearchAlertFrequency {
  OFF
  INSTANT
  WEEKLY
}

enum PropertyAlertType {
  PRICE_DROP
  NEW_PROPERTY
  SAVED_SEARCH_MATCH
}

// ─── Auth.js / User ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  /** Pending e-mail change — applied only after verification. */
  pendingEmail  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  financialProfile      FinancialProfile?
  propertyPreference    PropertyPreference?
  investmentPreference  InvestmentPreference?
  consents              Consent[]
  favourites            Favourite[]
  comparisons           Comparison[]
  savedSearches         SavedSearch[]
  alertSubscriptions    PropertyAlertSubscription[]
  analyses              PropertyAnalysis[]
  leads                 Lead[]
  orders                Order[]
  notifications         Notification[]
  auditLogs               AuditLog[]                   @relation("AuditActor")
  configUpdates           AppConfiguration[]           @relation("ConfigUpdater")
  reviewedDuplicates      PropertyDuplicateCandidate[] @relation("DuplicateReviewer")
  fieldOverridesCreated   PropertyFieldOverride[]      @relation("FieldOverrideCreator")
  fieldOverridesUpdated   PropertyFieldOverride[]      @relation("FieldOverrideUpdater")
  ownedProperties         Property[]                   @relation("PropertyOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  phone                  String?
  preferredLocale        String    @default("cs")
  investmentGoal         String?
  /** Onboarding goal: OWN_HOME | INVESTMENT | RENOVATION | FLIP | EXPLORING */
  onboardingGoal         String?
  onboardingStep         Int       @default(1)
  onboardingCompletedAt  DateTime?
  onboardingSkippedAt    DateTime?
  notes                  String?   @db.Text
  /** Transactional alerts (orders, security). Defaults on — not marketing. */
  notifyTransactionalEmail Boolean @default(true)
  notifyTransactionalInApp Boolean @default(true)
  /** Marketing — must default false; never pre-checked in UI. */
  notifyMarketingEmail     Boolean @default(false)
  notifyMarketingInApp     Boolean @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  monthlyIncomeCzk      Int?
  monthlyLiabilitiesCzk Int?
  availableEquityCzk    Int?
  /** Optional share of purchase price as own funds (0–100). */
  equityPercent         Float?
  /** MORTGAGE | MIXED | CASH */
  financingMode         String?
  employmentType        String?
  creditScoreBand       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  granted   Boolean
  version   String
  grantedAt DateTime?
  revokedAt DateTime?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/** Catalog of legal / consent document versions (terms, privacy, …). */
model ConsentVersion {
  id            String      @id @default(cuid())
  type          ConsentType
  version       String
  title         String
  summary       String?     @db.Text
  documentUrl   String?
  effectiveFrom DateTime    @default(now())
  isCurrent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([type, version])
  @@index([type, isCurrent])
}

/** Property search / listing preferences (onboarding Part 2+). */
model PropertyPreference {
  id             String         @id @default(cuid())
  userId         String         @unique
  propertyTypes  PropertyType[]
  minPriceCzk    Int?
  maxPriceCzk    Int?
  minAreaSqm     Float?
  maxAreaSqm     Float?
  preferredCity  String?
  regions        String[]
  dispositions  String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Investment strategy preferences (onboarding Part 2+). */
model InvestmentPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  strategies              String[]
  targetGrossYieldPct     Float?
  targetCashFlowMonthlyCzk Int?
  maxRiskLevel            String?
  holdPeriodYears         Int?
  financingPreferred      Boolean?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Brute-force protection for auth endpoints.
 * Key is typically "ip:email" or "ip".
 */
model AuthRateLimit {
  id          String    @id @default(cuid())
  key         String    @unique
  failCount   Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ─── Properties & locations ──────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /** Public-facing label, e.g. "Praha 2 – Vinohrady". */
  publicName String?
  region    String?
  district  String?
  city      String?
  country   String   @default("CZ")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics    LocationMetric[]
  properties Property[]
}

model LocationMetric {
  id         String   @id @default(cuid())
  locationId String
  type       String
  value      Float
  unit       String?
  period     String?
  source     String?
  recordedAt DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, type])
}

/**
 * Canonical property — multi-source listing subject.
 * Exact address fields are internal; public surfaces must respect addressPrecision + visibility.
 */
model Property {
  id            String             @id @default(cuid())
  slug          String             @unique
  /** Stable cross-source identity key (Part 2+ dedup). */
  canonicalKey  String             @unique
  status        PropertyStatus     @default(DRAFT)
  visibility    PropertyVisibility @default(PUBLIC)
  transactionType TransactionType  @default(SALE)
  publishedAt   DateTime?
  /** Lifecycle — multi-source freshness (stale when source silent). */
  firstSeenAt   DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  lastFetchedAt DateTime?
  freshness     PropertyFreshness  @default(FRESH)
  staleMarkedAt DateTime?
  /** Demo / seed listings — never treated as live market offers. */
  isDemo        Boolean            @default(false)
  /** Owner for PRIVATE / ACCOUNT_ONLY access checks (IDOR guard). */
  ownerUserId   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // ── Basics ───────────────────────────────────────────────────────────────
  title            String
  description      String?            @db.Text
  propertyType     PropertyType
  condition        PropertyCondition  @default(UNKNOWN)
  constructionType ConstructionType  @default(UNKNOWN)
  ownershipType    OwnershipType      @default(UNKNOWN)

  // ── Price ────────────────────────────────────────────────────────────────
  askingPrice         Int?
  originalAskingPrice Int?
  /** @deprecated Prefer askingPrice — kept for existing readers. */
  priceCzk            Int?
  currency            String  @default("CZK")
  pricePerSqm         Float?
  negotiable          Boolean @default(false)

  // ── Size & layout ────────────────────────────────────────────────────────
  usableArea   Float?
  floorArea    Float?
  landArea     Float?
  /** @deprecated Prefer usableArea. */
  areaSqm      Float?
  layout       String?
  /** @deprecated Prefer layout (e.g. 3+kk). */
  disposition  String?
  roomsCount   Int?
  bedroomsCount Int?
  bathroomsCount Int?

  // ── Building ─────────────────────────────────────────────────────────────
  floor           Int?
  floorsTotal     Int?
  yearBuilt       Int?
  yearRenovated   Int?
  energyRating    EnergyRating @default(UNKNOWN)
  parkingSpaces   Int?
  hasElevator     Boolean?
  buildingName    String?

  // ── Public location (safe to show when precision allows) ─────────────────
  publicLabel      String?
  addressPrecision AddressPrecision @default(APPROXIMATE)
  publicCity       String?
  publicDistrict   String?
  publicRegion     String?

  // ── Internal / precise location (not for public by default) ──────────────
  street             String?
  houseNumber        String?
  orientationNumber  String?
  zip                String?
  /** Internal city (may equal publicCity). */
  city               String?
  latitude           Float?
  longitude          Float?
  locationId         String?

  location        Location?               @relation(fields: [locationId], references: [id])
  owner           User?                   @relation("PropertyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  features        PropertyFeatures?
  attributes      PropertyAttribute[]
  fieldProvenance PropertyFieldProvenance[]
  sources         PropertySource[]
  media           PropertyMedia[]
  /** @deprecated Prefer PropertyMedia. */
  images          PropertyImage[]
  priceHistory    PropertyPriceHistory[]
  statusHistory   PropertyStatusHistory[]
  duplicateAsA    PropertyDuplicateCandidate[] @relation("DuplicatePropertyA")
  duplicateAsB    PropertyDuplicateCandidate[] @relation("DuplicatePropertyB")
  mergeTargets    PropertyDuplicateCandidate[] @relation("DuplicateMergeTarget")
  qualityIssues   DataQualityIssue[]
  completeness    DataCompletenessScore?
  fieldOverrides  PropertyFieldOverride[]
  analyses        PropertyAnalysis[]
  favourites      Favourite[]
  comparisonItems ComparisonItem[]
  leads           Lead[]
  valuations      Valuation[]

  @@index([status, visibility])
  @@index([propertyType, transactionType])
  @@index([askingPrice])
  @@index([pricePerSqm])
  @@index([publicCity])
  @@index([publicCity, publicDistrict])
  @@index([publicRegion])
  @@index([locationId])
  @@index([latitude, longitude])
  @@index([status, askingPrice])
  @@index([status, publicCity, askingPrice])
  @@index([freshness, lastSeenAt])
  @@index([transactionType, status, askingPrice])
  @@index([isDemo])
  @@index([ownerUserId])
  /** Prompt 8 discovery / filter indexes */
  @@index([status, propertyType, askingPrice])
  @@index([status, publicCity, propertyType])
  @@index([status, condition])
  @@index([status, ownershipType])
  @@index([status, publishedAt])
  @@index([status, layout, askingPrice])
  @@index([layout])
  @@index([usableArea])
  @@index([landArea])
}

/** Fixed boolean / count feature flags (1:1). */
model PropertyFeatures {
  id              String  @id @default(cuid())
  propertyId      String  @unique
  balcony         Boolean @default(false)
  loggia          Boolean @default(false)
  terrace         Boolean @default(false)
  garden          Boolean @default(false)
  cellar          Boolean @default(false)
  garage          Boolean @default(false)
  parking         Boolean @default(false)
  elevator        Boolean @default(false)
  furnished       Boolean @default(false)
  barrierFree     Boolean @default(false)
  airConditioning Boolean @default(false)
  fireplace       Boolean @default(false)
  pool            Boolean @default(false)
  alarm           Boolean @default(false)
  internet        Boolean @default(false)
  cableTv         Boolean @default(false)
  washingMachine  Boolean @default(false)
  dishwasher      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/** Flexible EAV attributes for source-specific / evolving parameters. */
model PropertyAttribute {
  id        String                     @id @default(cuid())
  propertyId String
  key       String
  value     String                     @db.Text
  valueType PropertyAttributeValueType @default(STRING)
  unit      String?
  source    String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@index([key])
}

/**
 * Which source last confirmed a canonical field (field-level provenance).
 * Separates multi-source truth from raw payloads.
 */
model PropertyFieldProvenance {
  id         String   @id @default(cuid())
  propertyId String
  /** Canonical field path, e.g. "askingPrice", "usableArea", "publicLabel". */
  fieldKey   String
  sourceId   String?
  observedAt DateTime @default(now())
  confidence Float?
  /** Optional string snapshot of the value at observation time (not a DTO). */
  valueSnapshot String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([propertyId, fieldKey])
  @@index([sourceId])
  @@index([fieldKey])
}

model PropertySource {
  id                  String            @id @default(cuid())
  propertyId          String
  sourceType          PropertySourceType @default(OTHER)
  /** Vendor / portal name, e.g. "sreality", "partner:acme". */
  provider            String
  externalPropertyId  String?
  /** @deprecated Prefer externalPropertyId. */
  externalId          String?
  url                 String?
  licenseStatus       LicenseStatus     @default(UNKNOWN)
  isPrimary           Boolean           @default(false)
  firstSeenAt         DateTime          @default(now())
  lastSeenAt          DateTime          @default(now())
  lastFetchedAt       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  property        Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payloads        PropertySourcePayload[]
  fieldProvenance PropertyFieldProvenance[]
  priceEvents     PropertyPriceHistory[]
  statusEvents    PropertyStatusHistory[]
  media           PropertyMedia[]

  @@unique([provider, externalPropertyId])
  @@index([propertyId, sourceType])
  @@index([lastSeenAt])
}

/**
 * Raw / minimized source payload — isolated from production DTOs.
 * Store only what licensing allows; prefer piiRedacted = true.
 */
model PropertySourcePayload {
  id          String   @id @default(cuid())
  sourceId    String
  /** Minimized JSON blob from the source adapter (not a domain DTO). */
  payload     Json
  contentType String   @default("application/json")
  byteSize    Int?
  piiRedacted Boolean  @default(true)
  storedAt    DateTime @default(now())

  source PropertySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, storedAt])
}

model PropertyMedia {
  id              String           @id @default(cuid())
  propertyId      String
  sourceId        String?
  url             String
  type            PropertyMediaType @default(PHOTO)
  sortOrder       Int              @default(0)
  licenseStatus   LicenseStatus    @default(UNKNOWN)
  alt             String?
  title           String?
  mimeType        String?
  width           Int?
  height          Int?
  isPrimary       Boolean          @default(false)
  /** True when URL is a brand/system placeholder (missing real asset). */
  isPlaceholder   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, type, sortOrder])
  @@index([sourceId])
}

/** @deprecated Prefer PropertyMedia. Kept for early scaffolding. */
model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyPriceHistory {
  id         String          @id @default(cuid())
  propertyId String
  sourceId   String?
  amount     Int
  /** @deprecated Prefer amount (same CZK legacy). */
  priceCzk   Int?
  currency   String          @default("CZK")
  changeType PriceChangeType @default(INITIAL)
  observedAt DateTime        @default(now())
  note       String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, observedAt])
  @@index([sourceId])
}

model PropertyStatusHistory {
  id             String         @id @default(cuid())
  propertyId     String
  sourceId       String?
  previousStatus PropertyStatus?
  newStatus      PropertyStatus
  /** @deprecated Prefer newStatus. */
  status         PropertyStatus?
  changedAt      DateTime       @default(now())
  reason         String?
  note           String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, changedAt])
  @@index([sourceId])
}

// ─── Deduplikace, data quality, overrides (Prompt 7 Part 3) ─────────────────

model PropertyDuplicateCandidate {
  id                  String                   @id @default(cuid())
  propertyAId         String
  propertyBId         String
  similarityScore     Float
  /** Weighted component scores for auditability. */
  scoreBreakdown      Json?
  status              DuplicateCandidateStatus @default(PENDING)
  /** Canonical property kept after a non-destructive merge decision. */
  mergeIntoPropertyId String?
  reviewedAt          DateTime?
  reviewedById        String?
  notes               String?                  @db.Text
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  propertyA   Property  @relation("DuplicatePropertyA", fields: [propertyAId], references: [id], onDelete: Cascade)
  propertyB   Property  @relation("DuplicatePropertyB", fields: [propertyBId], references: [id], onDelete: Cascade)
  mergeInto   Property? @relation("DuplicateMergeTarget", fields: [mergeIntoPropertyId], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([propertyAId, propertyBId])
  @@index([status, similarityScore])
  @@index([mergeIntoPropertyId])
}

model DataQualityIssue {
  id         String                 @id @default(cuid())
  propertyId String
  ruleCode   String
  severity   DataQualitySeverity
  message    String
  field      String?
  status     DataQualityIssueStatus @default(OPEN)
  detectedAt DateTime               @default(now())
  resolvedAt DateTime?
  meta       Json?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([ruleCode, severity])
  @@index([detectedAt])
}

/** Snapshot of how completely a listing is filled (internal QA metric). */
model DataCompletenessScore {
  id         String   @id @default(cuid())
  propertyId String   @unique
  /** 0–100 overall completeness. */
  score      Float
  /** Per-dimension flags / weights, e.g. { price: 1, location: 0.5, area: 1 }. */
  breakdown  Json
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/**
 * Analyst lock / manual override — import feeds must not overwrite locked fields.
 */
model PropertyFieldOverride {
  id          String                     @id @default(cuid())
  propertyId  String
  fieldKey    String
  value       String                     @db.Text
  valueType   PropertyAttributeValueType @default(STRING)
  locked      Boolean                    @default(true)
  reason      String?
  createdById String?
  updatedById String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("FieldOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("FieldOverrideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, fieldKey])
  @@index([locked])
}

// ─── Import jobs (Prompt 7 Part 4) ───────────────────────────────────────────

model ImportJob {
  id              String             @id @default(cuid())
  /** Stable key so the same scheduled run / webhook is not processed twice. */
  idempotencyKey  String             @unique
  provider        String
  sourceType      PropertySourceType @default(OTHER)
  status          ImportJobStatus    @default(PENDING)
  processedCount  Int                @default(0)
  successCount    Int                @default(0)
  errorCount      Int                @default(0)
  skippedCount    Int                @default(0)
  /** Structured error summaries for ops dashboards. */
  errors          Json?
  meta            Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items ImportJobItem[]

  @@index([provider, status])
  @@index([createdAt])
}

/**
 * Per-record import unit — idempotent via provider + external id / payload hash.
 */
model ImportJobItem {
  id                 String              @id @default(cuid())
  jobId              String
  /** Globally unique: provider:externalId or provider:sha256(payload). */
  idempotencyKey     String              @unique
  externalPropertyId String?
  propertyId         String?
  status             ImportJobItemStatus @default(PENDING)
  errorMessage       String?
  payloadHash        String?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([propertyId])
  @@index([externalPropertyId])
}

// ─── Analysis & calculations ─────────────────────────────────────────────────

model PropertyAnalysis {
  id           String         @id @default(cuid())
  userId       String?
  propertyId   String?
  status       AnalysisStatus @default(DRAFT)
  tier         AnalysisTier   @default(BASIC)
  majetioScore Float?
  summary      String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  property                Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scenarios               AnalysisScenario[]
  valuations              Valuation[]
  investmentCalculations  InvestmentCalculation[]
  renovationEstimates     RenovationEstimate[]
  orders                  Order[]
}

model AnalysisScenario {
  id           String   @id @default(cuid())
  analysisId   String
  name         String
  assumptions  Json
  results      Json?
  createdAt    DateTime @default(now())

  analysis PropertyAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Valuation {
  id                String   @id @default(cuid())
  analysisId        String?
  propertyId        String?
  estimatedValueCzk Int
  method            String
  confidence        Float?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  analysis    PropertyAnalysis?     @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  property    Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  comparables ValuationComparable[]
}

model ValuationComparable {
  id              String  @id @default(cuid())
  valuationId     String
  label           String
  priceCzk        Int?
  areaSqm         Float?
  distanceMeters  Int?
  externalRef     String?
  propertyId      String?

  valuation Valuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)
}

model InvestmentCalculation {
  id            String   @id @default(cuid())
  analysisId    String
  engineVersion String
  inputs        Json
  outputs       Json
  createdAt     DateTime @default(now())

  analysis PropertyAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model RenovationEstimate {
  id               String   @id @default(cuid())
  analysisId       String
  scope            String
  estimatedCostCzk Int
  contingencyPct   Float    @default(10)
  lineItems        Json?
  createdAt        DateTime @default(now())

  analysis PropertyAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

// ─── User workspace ──────────────────────────────────────────────────────────

model Favourite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Comparison {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ComparisonItem[]
}

model ComparisonItem {
  id           String @id @default(cuid())
  comparisonId String
  propertyId   String
  sortOrder    Int    @default(0)

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, propertyId])
}

model SavedSearch {
  id             String                    @id @default(cuid())
  userId         String
  name           String
  /** Structured filters snapshot (URL state / search input). */
  filters        Json
  /** @deprecated Prefer filters — kept for older rows. */
  criteria       Json?
  sort           String?
  /** Schema version of `filters` payload for migrations. */
  filtersVersion Int                       @default(1)
  alertFrequency SavedSearchAlertFrequency @default(OFF)
  lastAlertedAt  DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertSubscriptions PropertyAlertSubscription[]

  @@index([userId, updatedAt])
  @@index([userId, alertFrequency])
}

/**
 * Architectural foundation for future property alerts (price drop / new match).
 * No mail jobs yet — subscriptions + typed events only.
 */
model PropertyAlertSubscription {
  id            String              @id @default(cuid())
  userId        String
  savedSearchId String?
  alertType     PropertyAlertType
  enabled       Boolean             @default(true)
  channel       NotificationChannel @default(IN_APP)
  meta          Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([userId, savedSearchId, alertType, channel])
  @@index([userId, enabled])
  @@index([alertType, enabled])
}

model PropertyAlertEvent {
  id            String           @id @default(cuid())
  userId        String
  savedSearchId String?
  propertyId    String?
  alertType     PropertyAlertType
  payload       Json?
  /** Set when delivered to Notification / email worker. */
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([alertType, deliveredAt])
  @@index([propertyId])
}

// ─── Leads, commerce, partners ───────────────────────────────────────────────

model Lead {
  id         String     @id @default(cuid())
  type       LeadType
  status     LeadStatus @default(NEW)
  userId     String?
  propertyId String?
  email      String?
  phone      String?
  payload    Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  property   Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?  @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  analysisId      String?
  status          OrderStatus @default(PENDING)
  productKey      String
  amountCzk       Int
  currency        String      @default("CZK")
  configSnapshot  Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis PropertyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  payments Payment[]
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  status           PaymentStatus @default(PENDING)
  amountCzk        Int
  currency         String        @default("CZK")
  provider         String?
  providerPaymentId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  type      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?             @db.Text
  readAt    DateTime?
  meta      Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}

model AppConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}
