/**
 * Property deal record — sensitivity PROTECTED.
 * Agreed price must only be read via audited accessor (never public DTOs / analytics).
 * Purchase Concierge agency promises gated by TRANSACTION_SUCCESS_FEE_ENABLED=false default.
 */
model PropertyTransaction {
  id                 String                    @id @default(cuid())
  propertyId         String
  buyerUserId        String?
  agentUserId        String?
  organizationId     String?
  status             PropertyTransactionStatus @default(EXPLORING)
  sensitivityClass   DataSensitivityClass      @default(PROTECTED)
  currency           String                    @default("CZK")
  /**
   * Agreed purchase price in minor units — PROTECTED / Sensitive.
   * Never log, never expose in public serializers, never send to partners without consent.
   */
  agreedPriceMinor   Int?
  agreedPriceSetAt   DateTime?
  /** Concierge / success-fee path — only when feature flag enabled. */
  conciergeEnabled   Boolean                   @default(false)
  closedAt           DateTime?
  meta               Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer        User?         @relation("PropertyTransactionBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  agent        User?         @relation("PropertyTransactionAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accessLogs   PropertyTransactionAccessLog[]

  @@index([propertyId, status])
  @@index([buyerUserId, status])
  @@index([organizationId, status])
  @@index([sensitivityClass, status])
  @@index([status, updatedAt])
