  @@index([listedByUserId])
  @@index([listingVerificationStatus])
  @@index([listingQuotaState, status])
  @@index([listingModerationStatus, status])
  /** Prompt 8 discovery / filter indexes */
  @@index([status, propertyType, askingPrice])
  @@index([status, publicCity, propertyType])
  @@index([status, condition])
  @@index([status, ownershipType])
  @@index([status, publishedAt])
