  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([grossYieldPct])
  @@index([netYieldPct])
  @@index([monthlyCashflowCzk])
  @@index([cashOnCashPct])
  @@index([paybackYears])
  @@index([majetioScore])
  @@index([dataConfidencePct])
  @@index([tenantDemandScore])
  @@index([discountToEstimatedValuePct])
  @@index([calculatedAt])
}

/** Fixed boolean / count feature flags (1:1). */
model PropertyFeatures {
  id              String  @id @default(cuid())
  propertyId      String  @unique
  balcony         Boolean @default(false)
  loggia          Boolean @default(false)
  terrace         Boolean @default(false)
  garden          Boolean @default(false)
  cellar          Boolean @default(false)
  garage          Boolean @default(false)
  parking         Boolean @default(false)
  elevator        Boolean @default(false)
  furnished       Boolean @default(false)
  barrierFree     Boolean @default(false)
  airConditioning Boolean @default(false)
  fireplace       Boolean @default(false)
  pool            Boolean @default(false)
  alarm           Boolean @default(false)
  internet        Boolean @default(false)
  cableTv         Boolean @default(false)
  washingMachine  Boolean @default(false)
  dishwasher      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/** Flexible EAV attributes for source-specific / evolving parameters. */
model PropertyAttribute {
  id        String                     @id @default(cuid())
  propertyId String
  key       String
  value     String                     @db.Text
  valueType PropertyAttributeValueType @default(STRING)
  unit      String?
  source    String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@index([key])
}

/**
 * Localized property strings with translation provenance.
 * Keep original language; AI translations require machineGenerated=true.
 */
model PropertyLocalizedText {
  id                 String   @id @default(cuid())
  propertyId         String
  /** title | description | address_label | project_name | … */
  field              String
  originalLocale     String
  originalText       String   @db.Text
  translatedLocale   String?
  translatedText     String?  @db.Text
  translationSource  String   @default("ORIGINAL")
  machineGenerated   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, field])
  @@index([originalLocale])
  @@index([machineGenerated])
}

/**
 * Which source last confirmed a canonical field (field-level provenance).
 * Separates multi-source truth from raw payloads.
 */
model PropertyFieldProvenance {
  id         String   @id @default(cuid())
  propertyId String
  /** Canonical field path, e.g. "askingPrice", "usableArea", "publicLabel". */
  fieldKey   String
  sourceId   String?
  observedAt DateTime @default(now())
  confidence Float?
  /** Optional string snapshot of the value at observation time (not a DTO). */
  valueSnapshot String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([propertyId, fieldKey])
  @@index([sourceId])
  @@index([fieldKey])
}

model PropertySource {
  id                  String             @id @default(cuid())
  propertyId          String
  sourceType          PropertySourceType @default(OTHER)
  /** Vendor / portal name, e.g. "sreality", "partner:acme". */
  provider            String
  externalPropertyId  String?
  /** @deprecated Prefer externalPropertyId. */
  externalId          String?
  url                 String?
  licenseStatus       LicenseStatus      @default(UNKNOWN)
  /** Per-row health; DISABLED stops feed apply for this source row. */
  healthStatus        SourceHealthStatus @default(HEALTHY)
  /** When set and past, treat license as expired until renewed. */
  licenseExpiresAt    DateTime?
  /** When false, import workers must skip this source row. */
  importEnabled       Boolean            @default(true)
  /** When false, public UI must not attribute / deep-link this source. */
  frontendVisible     Boolean            @default(true)
  isPrimary           Boolean            @default(false)
  firstSeenAt         DateTime           @default(now())
  lastSeenAt          DateTime           @default(now())
  lastFetchedAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  property        Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payloads        PropertySourcePayload[]
  fieldProvenance PropertyFieldProvenance[]
  priceEvents     PropertyPriceHistory[]
  statusEvents    PropertyStatusHistory[]
  media           PropertyMedia[]

  @@unique([provider, externalPropertyId])
  @@index([propertyId, sourceType])
  @@index([lastSeenAt])
  @@index([provider, healthStatus])
  @@index([licenseExpiresAt])
  @@index([importEnabled])
}

/**
 * Provider-level license / import governance (Source Management).
 * One row per provider key — stops import or hides frontend attribution en masse.
 */
model DataSourceProviderConfig {
  provider            String             @id
  displayName         String?
  healthStatus        SourceHealthStatus @default(HEALTHY)
  licenseStatus       LicenseStatus      @default(UNKNOWN)
  licenseExpiresAt    DateTime?
  importEnabled       Boolean            @default(true)
  frontendVisible     Boolean            @default(true)
  notes               String?            @db.Text
  updatedByUserId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([healthStatus])
  @@index([licenseExpiresAt])
  @@index([importEnabled])
}

model PropertySourcePayload {
  id          String   @id @default(cuid())
  sourceId    String
  /** Minimized JSON blob from the source adapter (not a domain DTO). */
  payload     Json
  contentType String   @default("application/json")
  byteSize    Int?
  piiRedacted Boolean  @default(true)
  storedAt    DateTime @default(now())

  source PropertySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, storedAt])
}

model PropertyMedia {
  id              String           @id @default(cuid())
  propertyId      String
  sourceId        String?
  url             String
  type            PropertyMediaType @default(PHOTO)
  sortOrder       Int              @default(0)
  licenseStatus   LicenseStatus    @default(UNKNOWN)
  alt             String?
  title           String?
  mimeType        String?
  width           Int?
  height          Int?
  isPrimary       Boolean          @default(false)
  /** True when URL is a brand/system placeholder (missing real asset). */
  isPlaceholder   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, type, sortOrder])
  @@index([sourceId])
}

/** @deprecated Prefer PropertyMedia. Kept for early scaffolding. */
model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyPriceHistory {
  id         String          @id @default(cuid())
  propertyId String
  sourceId   String?
  amount     Int
  /** @deprecated Prefer amount (same CZK legacy). */
  priceCzk   Int?
  currency   String          @default("CZK")
  changeType PriceChangeType @default(INITIAL)
  observedAt DateTime        @default(now())
  note       String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, observedAt])
  @@index([sourceId])
}

model PropertyStatusHistory {
  id             String         @id @default(cuid())
  propertyId     String
  sourceId       String?
  previousStatus PropertyStatus?
  newStatus      PropertyStatus
  /** @deprecated Prefer newStatus. */
  status         PropertyStatus?
  changedAt      DateTime       @default(now())
  reason         String?
  note           String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source   PropertySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([propertyId, changedAt])
  @@index([sourceId])
}

// ─── Deduplikace, data quality, overrides (Prompt 7 Part 3) ─────────────────

model PropertyDuplicateCandidate {
  id                  String                   @id @default(cuid())
  propertyAId         String
  propertyBId         String
  similarityScore     Float
  /** Weighted component scores for auditability. */
  scoreBreakdown      Json?
  status              DuplicateCandidateStatus @default(PENDING)
  /** Canonical property kept after a non-destructive merge decision. */
  mergeIntoPropertyId String?
  reviewedAt          DateTime?
  reviewedById        String?
  notes               String?                  @db.Text
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  propertyA   Property  @relation("DuplicatePropertyA", fields: [propertyAId], references: [id], onDelete: Cascade)
  propertyB   Property  @relation("DuplicatePropertyB", fields: [propertyBId], references: [id], onDelete: Cascade)
  mergeInto   Property? @relation("DuplicateMergeTarget", fields: [mergeIntoPropertyId], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([propertyAId, propertyBId])
  @@index([status, similarityScore])
  @@index([mergeIntoPropertyId])
}

model DataQualityIssue {
  id         String                 @id @default(cuid())
  /** Property-scoped issues (listing QA). Optional when location-scoped. */
  propertyId String?
  /** Location Intelligence issues — reuse same issue table, no parallel system. */
  locationId String?
  ruleCode   String
  /** Rule catalog version for explainability / ML tuning. */
  ruleVersion String                @default("1")
  category   DataQualityIssueCategory @default(ANOMALY)
  severity   DataQualitySeverity
  message    String
  /**
   * Human-readable WHY — e.g. "Cena je o 83 % nižší než medián lokality".
   * Prefer over opaque "Suspicious".
   */
  explanation String?               @db.Text
  field      String?
  status     DataQualityIssueStatus @default(OPEN)
  detectedAt DateTime               @default(now())
  resolvedAt DateTime?
  resolutionReason String?          @db.Text
  resolvedByUserId String?
  reviewedAt DateTime?
  reviewedByUserId String?
  meta       Json?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  listingReport ListingReport?

  @@index([propertyId, status])
  @@index([locationId, status])
  @@index([ruleCode, severity])
  @@index([category, status])
  @@index([detectedAt])
  @@index([status, severity])
}

/**
 * User dispute / report of incorrect listing or data.
 * Creates a linked DataQualityIssue (USER_REPORT) for moderation ops.
 * Rate-limited at the application layer — never silently drop without feedback.
 */
model ListingReport {
  id                   String                 @id @default(cuid())
  propertyId           String
  reporterUserId       String?
  /** SHA-256 of client IP (or "unknown") — spam prevention without storing raw IP. */
  reporterIpHash       String?
  issueType            ListingReportIssueType
  /** Optional free-text detail (sanitized plain text). */
  details              String?                @db.Text
  status               ListingReportStatus    @default(OPEN)
  dataQualityIssueId   String?                @unique
  reviewedAt           DateTime?
  reviewedByUserId     String?
  resolutionNote       String?                @db.Text
  meta                 Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporter         User?             @relation("ListingReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("ListingReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  dataQualityIssue DataQualityIssue? @relation(fields: [dataQualityIssueId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([reporterIpHash, createdAt])
  @@index([issueType, status])
  @@index([status, createdAt])
}

/** Snapshot of how completely a listing is filled (internal QA metric). */
model DataCompletenessScore {
  id         String   @id @default(cuid())
  propertyId String   @unique
  /** 0–100 overall completeness. */
  score      Float
  /** Per-dimension flags / weights, e.g. { price: 1, location: 0.5, area: 1 }. */
  breakdown  Json
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/**
 * Analyst lock / manual override — import feeds must not overwrite locked fields.
 */
model PropertyFieldOverride {
  id          String                     @id @default(cuid())
  propertyId  String
  fieldKey    String
  value       String                     @db.Text
  valueType   PropertyAttributeValueType @default(STRING)
  locked      Boolean                    @default(true)
  reason      String?
  /** Manual ops tag — UI shows "Manuálně upraveno". */
  manualTag   Boolean                    @default(true)
  /** Optional expiry — after this, override is ignored by resolve. */
  expiresAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("FieldOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("FieldOverrideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, fieldKey])
  @@index([locked])
  @@index([expiresAt])
}

/**
 * Non-destructive merge audit — foundation for undo/revert.
 */
model PropertyMergeEvent {
  id                    String    @id @default(cuid())
  candidateId           String?
  canonicalPropertyId   String
  secondaryPropertyId   String
  /** MergePlan JSON (resolutions, locked fields). */
  planJson              Json
  /** Secondary property field snapshot before merge (for revert). */
  secondarySnapshot     Json
  /** Secondary status before merge. */
  secondaryPriorStatus  String
  reversedAt            DateTime?
  reversedByUserId      String?
  createdByUserId       String?
  createdAt             DateTime  @default(now())

  @@index([canonicalPropertyId, createdAt])
  @@index([secondaryPropertyId])
  @@index([candidateId])
}

// ─── Import jobs (Prompt 7 Part 4) ───────────────────────────────────────────

model ImportJob {
  id              String             @id @default(cuid())
  /** Stable key so the same scheduled run / webhook is not processed twice. */
  idempotencyKey  String             @unique
  provider        String
  sourceType      PropertySourceType @default(OTHER)
  status          ImportJobStatus    @default(PENDING)
  processedCount  Int                @default(0)
  successCount    Int                @default(0)
  errorCount      Int                @default(0)
  skippedCount    Int                @default(0)
  /** Structured error summaries for ops dashboards. */
  errors          Json?
  meta            Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items ImportJobItem[]

  @@index([provider, status])
  @@index([createdAt])
}

/**
 * Per-record import unit — idempotent via provider + external id / payload hash.
 */
model ImportJobItem {
  id                 String              @id @default(cuid())
  jobId              String
  /** Globally unique: provider:externalId or provider:sha256(payload). */
  idempotencyKey     String              @unique
  externalPropertyId String?
  propertyId         String?
  status             ImportJobItemStatus @default(PENDING)
  errorMessage       String?
  payloadHash        String?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([propertyId])
  @@index([externalPropertyId])
}

// ─── Analysis & calculations ─────────────────────────────────────────────────

model PropertyAnalysis {
  id           String         @id @default(cuid())
  userId       String?
  propertyId   String?
  status       AnalysisStatus @default(DRAFT)
  tier         AnalysisTier   @default(BASIC)
  majetioScore Float?
  summary      String?        @db.Text
  /**
   * Public methodology package version at analysis creation.
   * Historical rows must not be rewritten when the package bumps.
   */
  methodologyPackageVersion String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  property                Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scenarios               AnalysisScenario[]
  valuations              Valuation[]
  investmentCalculations  InvestmentCalculation[]
  renovationEstimates     RenovationEstimate[]
  renovationAnalyses      RenovationAnalysis[]
  orders                  Order[]
  leads                   Lead[]
  entitlements            Entitlement[]
}

/**
 * Named investment scenario with frozen inputs + engine version stamps.
 * Formula code changes must not rewrite historical rows — only create new ones.
 * Ownership: ownerUserId is the IDOR boundary for USER profile scenarios.
 */
model AnalysisScenario {
  id                       String                   @id @default(cuid())
  propertyId               String?
  analysisId               String?
  /** Session owner for USER scenarios — never accept from client. */
  ownerUserId              String?
  scenarioType             AnalysisScenarioType     @default(BASE_METRICS)
  profile                  AnalysisScenarioProfile  @default(USER)
  variant                  AnalysisScenarioVariant  @default(REALISTIC)
  status                   AnalysisScenarioStatus   @default(DRAFT)
  /** Sanitized human label (plain text, no HTML). */
  name                     String?
  /** Frozen property / market snapshot at calculation time. */
  inputSnapshot            Json
  /** User overrides applied on top of the property snapshot. */
  assumptionSet            Json
  /** Version key of assumption defaults used (e.g. assumptions.v2026.07). */
  assumptionConfigVersion  String                   @default("assumptions.v1")
  /** INVESTMENT_ENGINE_VERSION frozen at calc time. */
  calculationEngineVersion String
  /** FORMULA_REGISTRY_VERSION frozen at calc time. */
  formulaRegistryVersion   String
  /**
   * Public methodology package (UI-facing) frozen at calc time.
   * Never rewrite on package bump — clone preserves source stamp.
   */
  methodologyPackageVersion String?
  /** Deterministic hash(propertySnapshot + assumptions + versions + scenarioType). */
  inputHash                String
  /** Orchestrated partial/full result envelope (JSON). */
  results                  Json?
  /** Base currency for the scenario (ISO). */
  baseCurrency             String                   @default("CZK")
  /** Optional FX snapshot when an input was converted into baseCurrency. */
  exchangeRateSnapshot     Json?
  /** Public share of private scenarios is disabled by default (Part 2/B). */
  isPublicShareEnabled     Boolean                  @default(false)
  clonedFromId             String?
  /** Analyst workflow (only when profile = ANALYST). */
  analystReviewStatus      AnalystReviewStatus?
  analystReviewReason      String?                  @db.Text
  reviewedByUserId         String?
  reviewedAt               DateTime?
  approvedByUserId         String?
  approvedAt               DateTime?
  calculatedAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  property               Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  analysis               PropertyAnalysis?       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  owner                  User?                   @relation("AnalysisScenarioOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  reviewedBy             User?                   @relation("AnalysisScenarioReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedBy             User?                   @relation("AnalysisScenarioApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  clonedFrom             AnalysisScenario?       @relation("ScenarioClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones                 AnalysisScenario[]      @relation("ScenarioClone")
  investmentCalculations InvestmentCalculation[]
  renovationAnalyses     RenovationAnalysis[]

  @@index([ownerUserId, status, updatedAt])
  @@index([propertyId, scenarioType, status])
  @@index([analysisId])
  @@index([inputHash])
  @@index([calculationEngineVersion])
  @@index([profile, analystReviewStatus])
  @@index([status, calculatedAt])
  @@index([assumptionConfigVersion])
  @@index([methodologyPackageVersion])
}

/**
 * Versioned assumption defaults (vacancy, growth, spreads…).
 * Historical analyses reference assumptionConfigVersion — never mutate past rows.
 */
model AssumptionConfigVersion {
  id          String   @id @default(cuid())
  /** Stable key, e.g. assumptions.v2026.07 */
  versionKey  String   @unique
  /** Human label for admins. */
  label       String
  /** Effective from (inclusive). */
  effectiveFrom DateTime
  /** Optional end — null = current. */
  effectiveTo   DateTime?
  isCurrent   Boolean  @default(false)
  approvalStatus AnalyticsConfigApprovalStatus @default(DRAFT)
  approvedAt  DateTime?
  approvedByUserId String?
  changeReason String? @db.Text
  /**
   * Full defaults JSON:
   * { byPropertyType, byStrategy, byLocation, spreads, meta }
   */
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isCurrent])
  @@index([effectiveFrom])
  @@index([approvalStatus])
}

/**
 * Production valuation result (Prompt 10).
 * inputSnapshot freezes the inputs used at calculation time so later property
 * edits cannot rewrite historical estimates.
 */
model Valuation {
  id                   String                    @id @default(cuid())
  propertyId           String
  analysisId           String?
  modelRegistryId      String?
  type                 ValuationType
  /** Denormalized algorithm version string for reproducibility (e.g. residential_apartment_v1.2.0). */
  modelVersion         String
  status               ValuationStatus           @default(DRAFT)
  estimatedValue       Int?
  lowerBound            Int?
  upperBound            Int?
  estimatedPricePerSqm Float?
  confidenceLevel      ValuationConfidenceLevel  @default(UNKNOWN)
  /** 0–100 score; null when not yet calculated. */
  confidenceScore      Float?
  comparableCount      Int                       @default(0)
  currency             String                    @default("CZK")
  /** Frozen inputs (areas, features, filters, model params) — never mutate in place. */
  inputSnapshot        Json
  calculatedAt         DateTime?
  validUntil           DateTime?
  createdByUserId      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  property         Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  analysis         PropertyAnalysis?          @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  modelRegistry    ValuationModelRegistry?    @relation(fields: [modelRegistryId], references: [id], onDelete: SetNull)
  createdBy        User?                      @relation("ValuationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  comparables      ValuationComparable[]
  adjustmentAudits ValuationAdjustmentAudit[]

  @@index([propertyId, status])
  @@index([propertyId, calculatedAt])
  @@index([type, status])
  @@index([modelVersion])
  @@index([modelRegistryId])
  @@index([analysisId])
  @@index([validUntil])
}

/** Comparable used by a valuation — may link a canonical Property or external ref. */
model ValuationComparable {
  id                       String    @id @default(cuid())
  valuationId              String
  comparablePropertyId     String?
  distanceMeters           Int?
  pricePerSqm              Float?
  transactionOrAskingPrice Int?
  /** Observation / transaction date of the comparable. */
  observedAt               DateTime?
  similarityScore          Float?
  weight                   Float?
  included                 Boolean   @default(true)
  exclusionReason          String?
  label                    String?
  externalRef              String?
  createdAt                DateTime  @default(now())

  valuation          Valuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  comparableProperty Property? @relation("ValuationComparableProperty", fields: [comparablePropertyId], references: [id], onDelete: SetNull)

  @@index([valuationId, included])
  @@index([comparablePropertyId])
  @@index([valuationId, similarityScore])
}

/** Append-only history of analyst manual adjustments (never rewrite Valuation silently). */
model ValuationAdjustmentAudit {
  id            String   @id @default(cuid())
  valuationId   String
  actorUserId   String?
  fieldKey      String
  previousValue Json?
  newValue      Json?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  valuation Valuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ValuationAdjustmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([valuationId, createdAt])
  @@index([actorUserId])
}

/**
 * Registry of valuation algorithm versions and supported property types.
 * Example code: residential_apartment_v1
 */
model ValuationModelRegistry {
  id                     String                        @id @default(cuid())
  code                   String                        @unique
  displayName            String
  description            String?                       @db.Text
  algorithmVersion       String
  supportedPropertyTypes PropertyType[]
  /** @deprecated Prefer lifecycleStatus === ACTIVE. Kept in sync by governance. */
  isActive               Boolean                       @default(false)
  lifecycleStatus        ValuationModelLifecycleStatus @default(DRAFT)
  /**
   * Shadow mode — run evaluations in background without publishing as ACTIVE.
   */
  shadowMode             Boolean                       @default(false)
  /** Model this activation replaced (for safe rollback). */
  previousActiveModelId  String?
  approvedAt             DateTime?
  approvedByUserId       String?
  activatedAt            DateTime?
  activatedByUserId      String?
  rolledBackAt           DateTime?
  /** Market scope — never apply CZ model to AE inventory (Prompt 17.4). */
  marketCode             String                        @default("CZ")
  /** Non-secret config / notes (weights docs refs, changelog). */
  metadata               Json?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  valuations   Valuation[]
  performance  ValuationModelPerformanceSnapshot[]
  governanceEvents ModelGovernanceEvent[]

  @@index([isActive])
  @@index([lifecycleStatus])
  @@index([algorithmVersion])
  @@index([marketCode, lifecycleStatus])
  @@index([shadowMode])
}

/** Append-only governance transitions for valuation models. */
model ModelGovernanceEvent {
  id              String   @id @default(cuid())
  modelRegistryId String
  fromStatus      String
  toStatus        String
  actorUserId     String?
  reason          String   @db.Text
  shadowMode      Boolean?
  meta            Json?
  createdAt       DateTime @default(now())

  modelRegistry ValuationModelRegistry @relation(fields: [modelRegistryId], references: [id], onDelete: Cascade)

  @@index([modelRegistryId, createdAt])
  @@index([createdAt])
}

/**
 * MAE / MAPE snapshots by market + segment for model performance dashboards.
 */
model ValuationModelPerformanceSnapshot {
  id              String   @id @default(cuid())
  modelRegistryId String
  marketCode      String   @default("CZ")
  segmentKey      String   @default("ALL")
  sampleSize      Int
  mae             Float
  mape            Float
  /** Prior snapshot MAE for regression alerts. */
  previousMae     Float?
  previousMape    Float?
  regressionAlert Boolean  @default(false)
  regressionNote  String?
  computedAt      DateTime @default(now())
  meta            Json?

  modelRegistry ValuationModelRegistry @relation(fields: [modelRegistryId], references: [id], onDelete: Cascade)

  @@index([modelRegistryId, computedAt])
  @@index([marketCode, segmentKey])
  @@index([regressionAlert])
}

/**
 * Versioned renovation unit-rate catalog (governance).
 * Code-backed demos remain; DB versions go through approval before ACTIVE.
 */
model RenovationCostCatalogVersion {
  id               String                        @id @default(cuid())
  versionKey       String                        @unique
  label            String
  marketCode       String                        @default("CZ")
  approvalStatus   AnalyticsConfigApprovalStatus @default(DRAFT)
  isCurrent        Boolean                       @default(false)
  /** Full catalog document JSON (entries + meta). */
  catalogJson      Json
  previousVersionKey String?
  changeReason     String?                       @db.Text
  anomalyFlags     Json?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([isCurrent])
  @@index([approvalStatus])
  @@index([marketCode])
}

/** Mortgage / HypotekaJasne feed ops — block auto-publish on anomaly. */
model MortgageFeedControl {
  id                 String   @id @default("default")
  autoPublishEnabled Boolean  @default(true)
  blockedReason      String?  @db.Text
  blockedAt          DateTime?
  blockedByUserId    String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model InvestmentCalculation {
  id                     String   @id @default(cuid())
  analysisId             String?
  scenarioId             String?
  propertyId             String?
  engineVersion          String
  formulaRegistryVersion String
  inputHash              String
  inputs                 Json
  outputs                Json
  createdAt              DateTime @default(now())

  analysis PropertyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  scenario AnalysisScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  property Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([inputHash, engineVersion])
  @@index([analysisId])
  @@index([scenarioId])
  @@index([propertyId, createdAt])
}

model RenovationEstimate {
  id               String   @id @default(cuid())
  analysisId       String
  scope            String
  estimatedCostCzk Int
  contingencyPct   Float    @default(10)
  lineItems        Json?
  createdAt        DateTime @default(now())

  analysis PropertyAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

/**
 * Renovation Engine primary entity (Prompt 12 / 1 of 5).
 * Cost bands (C) are stored here; ARV (D) stays in arv services / future columns —
 * do not treat estimated* as after-repair value.
 * Legacy CapEx-only rows remain in RenovationEstimate until migrated.
 */
model RenovationAnalysis {
  id                  String                    @id @default(cuid())
  propertyId          String?
  analysisId          String?
  scenarioId          String?
  type                RenovationAnalysisType    @default(AUTOMATIC)
  status              RenovationAnalysisStatus  @default(DRAFT)
  /** Frozen scope catalogue version (concept B). */
  scopeVersion        String
  /** Frozen CapEx model version (concept C). */
  costModelVersion    String
  /** Frozen location cost index version (concept C). */
  locationCostVersion String
  /** CapEx low band — CZK major; null = not calculated. */
  estimatedLow        Int?
  estimatedBase       Int?
  estimatedHigh       Int?
  /** Contingency Kč major — concept C support, not ARV. */
  contingencyAmount   Int?
  /** Duration in whole days. */
  estimatedDuration   Int?
  /** Confidence 0–100. */
  confidence          Float?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  calculatedAt        DateTime?

  property Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  analysis PropertyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  scenario AnalysisScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, updatedAt])
  @@index([analysisId])
  @@index([scenarioId])
  @@index([status, calculatedAt])
  @@index([scopeVersion])
  @@index([costModelVersion, locationCostVersion])
}

// ─── User workspace ──────────────────────────────────────────────────────────

/**
 * User-owned folder/collection for organising favourites.
 * Structure is ready; full collection management UI can come later.
 * Distinct from Property.status ARCHIVED and Favourite.archivedAt.
 */
model FavouriteCollection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /** Stable slug within user — e.g. investice, vlastni-bydleni. */
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  favourites Favourite[]

  @@unique([userId, slug])
  @@index([userId, sortOrder])
}

model Favourite {
  id         String          @id @default(cuid())
  userId     String
  propertyId String
  status     FavouriteStatus @default(CONSIDERING)
  /** Optional reject reason — only when status = REJECTED; never mandatory. */
  rejectionReason FavouriteRejectionReason?
  /** Optional free-text folder label (legacy / quick tag). Prefer collectionId when set. */
  folder     String?
  /** Optional structured collection (folders/kolekce). */
  collectionId String?
  /** Lower = higher list sort; null = unsorted. Distinct from decisionPriority. */
  priority   Int?
  /** Personal decision priority: HIGH / MEDIUM / LOW. */
  decisionPriority DecisionPriorityLevel?
  /** Private user note (Decision Workspace) — plain text, XSS-stripped. */
  note       String?         @db.Text
  /** Asking price snapshot when saved — for price-change display. */
  priceAtSave Int?
  /**
   * User archived a listing (e.g. sold) — kept for history/compare, hidden from active shortlist.
   * Distinct from Property.status ARCHIVED. UNAVAILABLE/SOLD favourites are never auto-removed.
   */
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Restrict: hard-delete of Property must not silently wipe private favourites. */
  property   Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  collection FavouriteCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, propertyId])
  @@index([userId, status, createdAt])
  @@index([userId, priority])
  @@index([userId, decisionPriority])
  @@index([userId, updatedAt])
  @@index([userId, folder])
  @@index([userId, collectionId])
  @@index([userId, status, archivedAt])
  @@index([userId, rejectionReason])
}

/**
 * User watches a location market profile (dashboard + future metric alerts).
 * Reuses PropertyAlertEvent / Notification delivery path — no email worker yet.
 */
model WatchedLocation {
  id             String   @id @default(cuid())
  userId         String
  locationSlug   String
  locationLabel  String?
  /** When true, LOCATION_METRIC_CHANGE events may be enqueued. */
  alertEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationSlug])
  @@index([userId, createdAt])
  @@index([locationSlug])
}

model Comparison {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  /**
   * Manual property id order chosen by the user.
   * Automation must never overwrite this once set.
   */
  manualOrder Json?
  /**
   * Optimistic concurrency token (BOD 152).
   * Clients must send expectedVersion; bump on every successful mutation.
   */
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties ComparisonProperty[]
  snapshots  ComparisonSnapshot[]
  shares     ComparisonShare[]

  @@index([userId, updatedAt])
}

enum ComparisonShareMode {
  /** Explicit invitee user ids only — no public URL. */
  INVITED_USERS
  /** High-entropy secret token + expiry; share-safe payload only. */
  SECRET_LINK
}

/**
 * Safe comparison sharing (BOD 78–81, 131).
 * Never stores Financial Passport / incomes / personal financing / private notes.
 */
model ComparisonShare {
  id           String               @id @default(cuid())
  comparisonId String
  createdById  String
  mode         ComparisonShareMode
  /**
   * High-entropy secret for SECRET_LINK (null for INVITED_USERS).
   * Store only a hash; raw token shown once at creation.
   */
  tokenHash    String?              @unique
  /** Token prefix for support lookup — never enough to authenticate. */
  tokenPrefix  String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  /**
   * Explicit share-safe field selection (JSON).
   * Forbidden keys must never appear: passport, income, financing private, notes.
   */
  includeFlags Json
  /** Frozen share-safe view built at create/refresh time. */
  safePayload  Json
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  lastAccessedAt DateTime?

  comparison Comparison                @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdBy  User                      @relation("ComparisonShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  invites    ComparisonShareInvite[]

  @@index([comparisonId, mode])
  @@index([expiresAt])
  @@index([createdById, createdAt])
}

model ComparisonShareInvite {
  id        String   @id @default(cuid())
  shareId   String
  userId    String
  createdAt DateTime @default(now())

  share ComparisonShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([userId])
}

/**
 * Frozen comparison metrics at time T (BOD 76, 77).
 * publicMetrics never includes personal financing / Finanční pas (BOD 146).
 * Refresh creates a new row; isCurrent marks the active snapshot.
 */
model ComparisonSnapshot {
  id            String   @id @default(cuid())
  comparisonId  String
  /** Public module metrics frozen at T — valuation, investment, renovation, location, risks. */
  publicMetrics Json
  /** Per-property fingerprints for stale detection vs live data. */
  fingerprints  Json
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId, isCurrent])
  @@index([comparisonId, createdAt])
}

/** Property slot in a comparison (max COMPARE_MAX from config). Domain alias: order → sortOrder. */
model ComparisonProperty {
  id           String   @id @default(cuid())
  comparisonId String
  propertyId   String
  /** Display order (0-based). */
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, propertyId])
  @@index([comparisonId, sortOrder])
}

/**
 * Private per-user property notes — owner-only.
 * Never expose via public API, analytics payloads, or SEO/JSON-LD.
 */
model PropertyUserNote {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  content    String   @db.Text
  /** Quick tags (prohlídka, SVJ, …) — private metadata. */
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, updatedAt])
}

/** Decision checklist tasks — owner-only private workspace data. */
model PropertyDecisionTask {
  id          String                     @id @default(cuid())
  userId      String
  propertyId  String
  type        PropertyDecisionTaskType   @default(CUSTOM)
  title       String
  status      PropertyDecisionTaskStatus @default(PENDING)
  dueDate     DateTime?
  /** True when created from default suggestion engine. */
  suggested   Boolean                    @default(false)
  createdAt   DateTime                   @default(now())
  completedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, propertyId, status])
  @@index([userId, dueDate])
}

/**
 * User Decision Matrix priorities (price, location, yield, …).
 * Prefillable from Finanční pas; never public.
 */
model DecisionPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  /** Map criterion → DecisionPriorityLevel */
  priorities  Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedSearch {
  id             String                    @id @default(cuid())
  userId         String
  name           String
  /** Structured filters snapshot (URL state / search input). */
  filters        Json
  /** @deprecated Prefer filters — kept for older rows. */
  criteria       Json?
  sort           String?
  /** Schema version of `filters` payload for migrations. */
  filtersVersion Int                       @default(1)
  alertFrequency SavedSearchAlertFrequency @default(OFF)
  lastAlertedAt  DateTime?
  /** Last time matches were recomputed against the catalog. */
  lastCheckedAt  DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertSubscriptions PropertyAlertSubscription[]
  matches            SavedSearchMatch[]

  @@index([userId, updatedAt])
  @@index([userId, alertFrequency])
}

/**
 * Real catalog matches for a saved search — no fake badges.
 * New results = rows with notifiedAt IS NULL after baseline sync.
 */
model SavedSearchMatch {
  id             String    @id @default(cuid())
  savedSearchId  String
  propertyId     String
  firstMatchedAt DateTime  @default(now())
  lastMatchedAt  DateTime  @default(now())
  /** Set when user was notified or acknowledged the match (baseline or alert). */
  notifiedAt     DateTime?

  savedSearch SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, propertyId])
  @@index([savedSearchId, notifiedAt])
  @@index([savedSearchId, firstMatchedAt])
  @@index([propertyId])
}

/**
 * Architectural foundation for future property alerts (price drop / new match).
 * No mail jobs yet — subscriptions + typed events only.
 */
model PropertyAlertSubscription {
  id            String              @id @default(cuid())
  userId        String
  savedSearchId String?
  alertType     PropertyAlertType
  enabled       Boolean             @default(true)
  channel       NotificationChannel @default(IN_APP)
  meta          Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([userId, savedSearchId, alertType, channel])
  @@index([userId, enabled])
  @@index([alertType, enabled])
}

model PropertyAlertEvent {
  id            String           @id @default(cuid())
  userId        String
  savedSearchId String?
  propertyId    String?
  alertType     PropertyAlertType
  payload       Json?
  /** Set when delivered to Notification / email worker. */
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())

  alerts PropertyAlert[]

  @@index([userId, createdAt])
  @@index([alertType, deliveredAt])
  @@index([propertyId])
}

/**
 * User-facing property alert (inbox).
 * Transactional by default — never mixed with marketing without consent.
 */
model PropertyAlert {
  id         String                     @id @default(cuid())
  userId     String
  propertyId String?
  type       PropertyAlertType
  eventId    String?
  channel    NotificationChannel        @default(IN_APP)
  status     PropertyAlertDeliveryStatus @default(PENDING)
  title      String
  body       String?                    @db.Text
  /** Idempotent delivery key — unique per user when set. */
  dedupeKey  String?
  /** Groups batched alerts (e.g. saved-search digest). */
  batchKey   String?
  href       String?
  meta       Json?
  createdAt  DateTime                   @default(now())
  sentAt     DateTime?
  readAt     DateTime?

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  event    PropertyAlertEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([propertyId, type, createdAt])
  @@index([batchKey])
  @@index([type, createdAt])
}

// ─── Leads, commerce, partners ───────────────────────────────────────────────

/**
 * Casual marketplace inquiry (message / viewing interest).
 * Strictly NOT a QualifiedBuyerLead — no budget, financing stance, or FP linkage.
 */
model Inquiry {
  id             String        @id @default(cuid())
  propertyId     String
  organizationId String?
  agentUserId    String?
  buyerUserId    String?
  status         InquiryStatus @default(NEW)
  buyerName      String?
  buyerEmail     String?
  buyerPhone     String?
  message        String?       @db.Text
  source         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agent        User?         @relation("InquiryAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  buyer        User?         @relation("InquiryBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  qualifiedLead QualifiedBuyerLead?

  @@index([propertyId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([agentUserId, status])
  @@index([buyerUserId, createdAt])
}

/**
 * Marketplace qualified buyer lead — product qualification + privacy handoff.
 *
 * Privacy:
 * - Before agent accept → only anonymizedQualifiedProfile (budget band, timeline, financing stance).
 * - Full FinancialProfile never exposed to agent without AGENT_BUYER_PROFILE_SHARE consent
 *   AND status ACCEPTED.
 *
 * Discrimination firewall: qualification uses ONLY allow-listed non-protected attributes.
 */
model QualifiedBuyerLead {
  id             String                    @id @default(cuid())
  inquiryId      String?                   @unique
  propertyId     String
  organizationId String?
  agentUserId    String?
  buyerUserId    String
  status         QualifiedBuyerLeadStatus  @default(PENDING_AGENT_REVIEW)

  /** Centralized rule version that produced this qualification. */
  qualificationRuleVersion String
  qualifiedAt              DateTime?
  contactVerification      ContactVerificationLevel @default(UNVERIFIED)
  contactVerified          Boolean @default(false)
  budgetKnown              Boolean @default(false)
  /** Coarse bands for agent pre-accept (not exact passport figures). */
  budgetBandMinCzk         Int?
  budgetBandMaxCzk         Int?
  financingStance          BuyerFinancingStance @default(UNKNOWN)
  /** e.g. 0_3m | 3_6m | 6_12m | 12m_plus */
  timelineBand             String?
  /** Immutable anonymized snapshot shown to agent before accept. */
  anonymizedProfileSnapshot Json?
  /** Consent row for fuller profile share (post-accept). */
  profileShareConsentId    String? @unique
  agentAcceptedAt          DateTime?
  agentDeclinedAt          DateTime?
  fullProfileRevealedAt    DateTime?
  declineReason            String?
  expiresAt                DateTime?
  /** SLA: first agent response due (default +24h from qualify). No public ranking. */
  slaDueAt                 DateTime?
  firstResponseAt          DateTime?
  slaBreachedAt            DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  inquiry      Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agent        User?         @relation("QualifiedBuyerAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  buyer        User          @relation("QualifiedBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  activities   QualifiedBuyerLeadActivity[]
  attributions LeadAttribution[]
  successFees  SuccessFeeRecord[]
  disputes     LeadDispute[]

  @@index([propertyId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([agentUserId, status])
  @@index([buyerUserId, createdAt])
  @@index([status, expiresAt])
  @@index([organizationId, slaDueAt])
  @@index([agentUserId, slaDueAt])
}

model QualifiedBuyerLeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?  @db.Text
  /** Must never contain raw income / liabilities / discriminatory attrs. */
  meta      Json?
  createdAt DateTime @default(now())

  lead QualifiedBuyerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Lead {
  id             String     @id @default(cuid())
  type           LeadType
  status         LeadStatus @default(NEW)
  userId         String?
  propertyId     String?
  analysisId     String?
  /** B2B org scope for agency managers. */
  organizationId String?
  /**
   * Pipeline owner (accountable) — distinct from assignee.
   * Checklist 142–145: owner drives nextAction accountability.
   */
  ownerUserId    String?
  /** Primary assignee (makléř / analytik). */
  assignedToUserId String?
  email          String?
  phone          String?
  /** Attribution source path, e.g. kalkulacky/financovani, nemovitosti/{slug}/financovani */
  source         String?
  /** Partner identifier, e.g. hypotekajasne */
  partner        String?
  /** Pipeline routing decision. */
  routingTarget  LeadRoutingTarget @default(UNASSIGNED)
  routingRuleKey String?
  nextActionType LeadNextActionType @default(NONE)
  nextActionDueAt DateTime?
  nextActionOwnerId String?
  /** XSS-safe plain text (never raw HTML). */
  nextActionNote String?
  /**
   * Internal expected deal value (haléře) — NEVER realized revenue / RevenueEvent.
   * Not exposed to buyers; staff/broker CRM only (185).
   */
  expectedValueMinor Int?
  expectedValueCurrency String @default("CZK")
  expectedValueNote String?
  statusChangedAt DateTime?
  consentId      String?    @unique
  /** External-safe correlation token — never expose internal Lead.id to partners */
  correlationId  String     @unique
  /** Idempotency guard for duplicate submits */
  idempotencyKey String?    @unique
  payload        Json?
  /** @deprecated Prefer marketCode — legacy routing field. */
  marketCountry  String?    @default("CZ")
  /**
   * Explicit MarketCode (CZ, AE, …). Never infer from currency.
   * Backfilled from marketCountry / default CZ for existing rows.
   */
  marketCode     String     @default("CZ")
  /** ISO 3166-1 alpha-2. */
  countryCode    String     @default("CZ")
  /** ISO 4217 listing / deal currency for this lead. */
  currency       String     @default("CZK")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  property        Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  analysis        PropertyAnalysis?   @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner           User?               @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignedTo      User?               @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  nextActionOwner User?               @relation("LeadNextActionOwner", fields: [nextActionOwnerId], references: [id], onDelete: SetNull)
  activities      LeadActivity[]
  assignments     LeadAssignment[]
  mortgageProfile MortgageLeadProfile?
  mortgageLeadCrm MortgageLeadCrm?
  contextSnapshot MortgageLeadContextSnapshot?
  submissionAttempts MortgageLeadSubmissionAttempt[]
  webhookEvents   HypotekaJasneWebhookEvent[]

  /** GDPR retention — when PII may be purged (set at creation from policy). */
  retentionExpiresAt DateTime?
  /** When sensitive profile fields were redacted (deletion / consent withdrawal). */
  piiRedactedAt      DateTime?
  /** User-initiated deletion request timestamp. */
  deletionRequestedAt DateTime?

  @@index([userId, propertyId, createdAt])
  @@index([userId, analysisId, createdAt])
  @@index([partner, createdAt])
  @@index([email, type, createdAt])
  @@index([retentionExpiresAt])
  @@index([organizationId, status, createdAt])
  @@index([assignedToUserId, status, nextActionDueAt])
  @@index([ownerUserId, status, nextActionDueAt])
  @@index([status, statusChangedAt])
  @@index([routingTarget, status])
  @@index([nextActionOwnerId, nextActionDueAt])
  @@index([marketCode, status, createdAt])
  @@index([marketCode, countryCode])
}

/**
 * Explicit assignment history / multi-assignee support for CRM pipeline.
 */
model LeadAssignment {
  id               String             @id @default(cuid())
  leadId           String
  userId           String
  organizationId   String?
  role             LeadAssignmentRole @default(ASSIGNEE)
  active           Boolean            @default(true)
  assignedAt       DateTime           @default(now())
  assignedByUserId String?
  unassignedAt     DateTime?
  note             String?
  createdAt        DateTime           @default(now())

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User          @relation("LeadAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedBy   User?         @relation("LeadAssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([leadId, userId, role])
  @@index([userId, active, assignedAt])
  @@index([organizationId, active])
  @@index([leadId, active])
}

/** Sensitive mortgage-specific fields — separated from Lead.payload JSON. */
model MortgageLeadProfile {
  id                    String                      @id @default(cuid())
  leadId                String                      @unique
  workflowStatus        MortgageLeadWorkflowStatus  @default(CREATED)
  availableEquityCzk    Int?
  monthlyIncomeCzk      Int?
  monthlyLiabilitiesCzk Int?
  purchasePriceCzk      Int?
  externalLeadId        String?
  partnerReference      String?
  isMockSubmission      Boolean                     @default(false)
  submittedAt           DateTime?
  receivedAt            DateTime?
  contactedAt           DateTime?
  lastPartnerSyncAt     DateTime?
  submissionAttempts    Int                         @default(0)
  lastSubmissionError   String?                     @db.Text
  nextRetryAt           DateTime?
  deadLetterAt          DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  lead              Lead                           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workflowStatus, updatedAt])
  @@index([workflowStatus, nextRetryAt])
  @@index([externalLeadId])
}

/**
 * Immutable context captured at lead creation (Prompt 13/10).
 * Never updated after insert — historical lead truth survives property price changes.
 */
model MortgageLeadContextSnapshot {
  id                         String   @id @default(cuid())
  leadId                     String   @unique
  schemaVersion              String   @default("mortgage-lead-snapshot.v1")
  capturedAt                 DateTime @default(now())
  propertyId                 String?
  propertySlug               String?
  propertyUrl                String?
  propertyTitle              String?
  askingPriceCzk             Int?
  valuationCzk               Int?
  requestedLoanCzk           Int?
  availableEquityCzk         Int?
  ltvOnAskingPricePct        Float?
  nominalInterestRatePp      Float?
  aprPp                      Float?
  termYears                  Int?
  estimatedMonthlyPaymentCzk Int?
  /** Full frozen payload for audit — write-once. */
  snapshotJson               Json

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/** CRM + internal value tracking — never expose to end-user UI (Prompt 13/9, Prompt 16). */
enum MortgageLeadCrmNextAction {
  AWAIT_PARTNER_RESPONSE
  CONTACT_CLIENT
  REQUEST_DOCUMENTS
  FOLLOW_UP
  NONE
}

model MortgageLeadCrm {
  id                      String                     @id @default(cuid())
  leadId                  String                     @unique
  ownerUserId             String?
  nextAction              MortgageLeadCrmNextAction  @default(AWAIT_PARTNER_RESPONSE)
  assignedToUserId        String?
  assignedAt              DateTime?
  routingCountry          String                     @default("CZ")
  routingPartner          String                     @default("hypotekajasne")
  routingRuleKey          String                     @default("cz-default-hypotekajasne")
  regulatoryConfigVersion String?
  /** INTERNAL — business reporting only */
  estimatedLoanAmountCzk  Int?
  /** INTERNAL — business reporting only */
  estimatedCommissionCzk  Int?
  valueMetricsUpdatedAt   DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner      User? @relation("MortgageLeadCrmOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("MortgageLeadCrmAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([routingPartner, routingCountry])
  @@index([ownerUserId])
  @@index([assignedToUserId, nextAction])
}

model MortgageLeadSubmissionAttempt {
  id           String                            @id @default(cuid())
  leadId       String
  attemptNumber Int
  status       MortgageLeadSubmissionAttemptStatus
  httpStatus   Int?
  errorCode    String?
  errorMessage String?                           @db.Text
  nextRetryAt  DateTime?
  createdAt    DateTime                          @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, attemptNumber])
  @@index([status, nextRetryAt])
}

/** Idempotent store for inbound HypotekaJasne webhook events. */
model HypotekaJasneWebhookEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  correlationId  String
  leadId         String?
  payload        Json
  signatureValid Boolean  @default(true)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([correlationId, createdAt])
  @@index([eventType, createdAt])
}

model LeadActivity {
  id         String                 @id @default(cuid())
  leadId     String
  type       String
  /** XSS-safe plain text — never store unsanitized HTML. */
  note       String?                @db.Text
  meta       Json?
  actorUserId String?
  visibility LeadActivityVisibility @default(SYSTEM)
  createdAt  DateTime               @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([visibility, createdAt])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  analysisId         String?
  /** Property scope for Deep Analysis / Boost / Professional Review grants. */
  propertyId         String?
  /** B2B org receiving subscription plan change after paid webhook. */
  organizationId     String?
  status             OrderStatus @default(PENDING)
  productKey         String
  /** Price version / plan version key frozen at checkout (historical pricing). */
  priceVersionKey    String
  /** Optional FK to catalog plan used at purchase (plan may later archive). */
  pricingPlanId      String?
  /** Gross amount charged (minor units / haléře for CZK). */
  amountGrossMinor   Int
  /** Net of VAT. */
  amountNetMinor     Int
  /** VAT amount. */
  amountVatMinor     Int
  vatRateBp          Int         @default(2100)
  currency           String      @default("CZK")
  /** Client must never set this — server snapshot of catalog + promo. */
  configSnapshot     Json?
  billingName        String?
  billingEmail       String?
  billingCompany     String?
  billingStreet      String?
  billingCity        String?
  billingZip         String?
  billingCountry     String?     @default("CZ")
  billingVatId       String?
  promoCodeId        String?
  /** Preferred promotion FK (Commerce Data Layer). */
  promotionId        String?
  promoCodeSnapshot  String?
  discountMinor      Int         @default(0)
  idempotencyKey     String?     @unique
  paidAt             DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  /** @deprecated Prefer amountGrossMinor — kept for older rows. */
  amountCzk          Int         @default(0)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis     PropertyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  property     Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  promoCode    PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promotion    Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  pricingPlan  PricingPlan?   @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  entitlements Entitlement[]
  refunds      PaymentRefund[]

  @@index([userId, status, createdAt])
  @@index([productKey, priceVersionKey])
  @@index([pricingPlanId])
  @@index([promotionId])
  @@index([propertyId])
  @@index([organizationId])
}

/**
 * Line item with frozen price snapshot at purchase time.
 * Never re-resolve list price from live PricingPlan for historical orders.
 */
model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  pricingPlanId        String?
  /** Catalog key snapshot (e.g. full_analysis). */
  planKey              String
  planVersionKey       String
  planName             String
  billingType          PricingBillingType @default(ONE_TIME)
  quantity             Int      @default(1)
  /** Unit list price before discount (gross minor). */
  unitListGrossMinor   Int
  unitPriceGrossMinor  Int
  unitPriceNetMinor    Int
  unitPriceVatMinor    Int
  discountMinor        Int      @default(0)
  lineGrossMinor       Int
  lineNetMinor         Int
  lineVatMinor         Int
  vatRateBp            Int      @default(2100)
  currency             String   @default("CZK")
  limitsSnapshot       Json?
  featuresSnapshot     Json?
  createdAt            DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pricingPlan PricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([planKey, planVersionKey])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  status             PaymentStatus @default(PENDING)
  amountGrossMinor   Int
  currency           String        @default("CZK")
  provider           String?
  providerPaymentId  String?
  providerCheckoutUrl String?
  failureCode        String?
  failureMessage     String?
  rawProviderStatus  String?
  /** @deprecated Prefer amountGrossMinor */
  amountCzk          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds PaymentRefund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
}

/**
 * Idempotent inbound payment provider events.
 * Duplicate delivery must not double-grant entitlements.
 */
model PaymentWebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  eventId          String
  eventType        String
  payload          Json
  signatureOk      Boolean   @default(false)
  /** Provider event timestamp (unix sec) — replay window check. */
  providerTimestamp Int?
  /** True when rejected as replay outside tolerance (audit). */
  replayRejected   Boolean   @default(false)
  processedAt      DateTime?
  processError     String?   @db.Text
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
  @@index([providerTimestamp])
}

model PaymentRefund {
  id               String   @id @default(cuid())
  orderId          String
  paymentId        String?
  amountMinor      Int
  currency         String   @default("CZK")
  reason           String?
  providerRefundId String?
  /** refund | chargeback | storno */
  kind             String   @default("refund")
  createdAt        DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/**
 * Product access grant — analysis/property-scoped when set.
 * Never create on FAILED payment; PENDING_GRANT when pay succeeded but grant failed.
 * B2C kinds: DEEP_ANALYSIS, BUYER_PASS, INVESTOR_PRO (+ FREE_TIER implicit).
 */
model Entitlement {
  id          String            @id @default(cuid())
  userId      String
  orderId     String?
  analysisId  String?
  /** Optional property scope (Deep Analysis). */
  propertyId  String?
  productKey  String
  kind        EntitlementKind   @default(LEGACY_PRODUCT)
  /**
   * Markets this entitlement unlocks. Default ["CZ"].
   * Use ["*"] only for explicitly global products — never imply UAE from CZ Buyer Pass.
   */
  marketScope String[]          @default(["CZ"])
  /** Paid vs free checkout vs manual admin — reporting must not mix (208/209). */
  source      EntitlementSource @default(PAID_ORDER)
  status      EntitlementStatus @default(ACTIVE)
  /** Required when source = MANUAL_ADMIN. */
  manualReason String?          @db.Text
  manualActorUserId String?
  manualGrantedAt DateTime?
  /**
   * Feature flags granted by this row (e.g. DEEP_ANALYSIS, ADVANCED_COMPARISON).
   * Empty = derive from kind + productKey via EntitlementService config.
   */
  featureKeys String[]          @default([])
  /** Content / engine version frozen at purchase (Deep Analysis refresh semantics). */
  contentVersionKey String?
  /** Hard end of access (Deep Analysis, Buyer Pass, Pro period). */
  expiresAt   DateTime?
  /**
   * After this instant a new Deep Analysis purchase is required for a refreshed
   * content version (not lifetime access).
   */
  refreshAfter DateTime?
  /** Investor Pro: still usable while PAST_DUE until this instant. */
  gracePeriodEndsAt DateTime?
  billingInterval EntitlementBillingInterval @default(NONE)
  cancelAtPeriodEnd Boolean @default(false)
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  grantedAt   DateTime?
  revokedAt   DateTime?
  revokeReason String?
  /** Retry counter for PENDING_GRANT recovery. */
  grantAttempts Int             @default(0)
  lastGrantError String?        @db.Text
  meta        Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  analysis PropertyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  property Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  manualActor User?          @relation("ManualEntitlementActor", fields: [manualActorUserId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([userId, productKey, status])
  @@index([userId, kind, status])
  @@index([userId, propertyId, kind])
  @@index([userId, status, expiresAt])
  @@index([status, grantAttempts])
  @@index([status, gracePeriodEndsAt])
  @@index([source, status])
  @@index([manualActorUserId])
  @@index([marketScope])
}

/**
 * Metered usage for entitlements / anti-scrape limits (Buyer Pass, Free tier).
 * windowKey = calendar day (YYYY-MM-DD) or ISO week (YYYY-Www).
 * scopeKey = propertyId or "_" when not property-scoped (unique-friendly).
 */
model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  featureKey String
  metricKey  String
  quantity   Int      @default(1)
  propertyId String?
  scopeKey   String   @default("_")
  windowKey  String
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([userId, featureKey, metricKey, windowKey, scopeKey])
  @@index([userId, featureKey, windowKey])
  @@index([userId, createdAt])
}

model PriceVersion {
  id           String   @id @default(cuid())
  productKey   String
  versionKey   String
  currency     String   @default("CZK")
  /** Gross list price in minor units. */
  amountGrossMinor Int
  vatRateBp    Int      @default(2100)
  activeFrom   DateTime @default(now())
  activeTo     DateTime?
  createdAt    DateTime @default(now())

  @@unique([productKey, versionKey])
  @@index([productKey, activeFrom])
}

/**
 * Data-driven versioned catalog — UI must not hardcode plan prices.
 * New commercial offers = new row / new versionKey; never mutate sold history.
 */
model PricingPlan {
  id                 String             @id @default(cuid())
  /** Stable product key across versions (basic_analysis, full_analysis, enterprise). */
  key                String
  versionKey         String
  name               String
  description        String?            @db.Text
  billingType        PricingBillingType @default(ONE_TIME)
  status             PricingPlanStatus  @default(DRAFT)
  /** Gross list price in minor units (haléře). */
  priceGrossMinor    Int
  currency           String             @default("CZK")
  /** Explicit MarketCode — plans are market-scoped (CZK plan ≠ AE AED plan). */
  marketCode         String             @default("CZ")
  /** ISO 3166-1 alpha-2. */
  countryCode        String             @default("CZ")
  /** Tax region for VAT/sales tax provider (may equal marketCode). */
  taxRegion          String             @default("CZ")
  vatRateBp          Int                @default(2100)
  /** Entitlement product key granted on paid order. */
  entitlesProductKey String
  /** Soft limits e.g. { "analysesPerMonth": 1, "comparisonsMax": 4 }. */
  limits             Json?
  /** Feature flags / labels e.g. ["valuation", "scenarios", "financing"]. */
  features           Json?
  sortOrder          Int                @default(100)
  /** Ops change note for this version. */
  changeReason       String?            @db.Text
  approvedAt         DateTime?
  approvedByUserId   String?
  /** Optional preview payload for admin UI before activate. */
  previewJson        Json?
  activeFrom         DateTime           @default(now())
  activeTo           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  orders        Order[]
  orderItems    OrderItem[]
  organizations Organization[]

  @@unique([key, versionKey])
  @@index([status, activeFrom])
  @@index([key, status])
  @@index([sortOrder])
  @@index([marketCode, status])
  @@index([marketCode, countryCode])
  @@index([marketCode, taxRegion, status])
}

/**
 * B2B SaaS tenant — real-estate agent, agency, developer, or channel partner.
 */
model Organization {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  type      OrganizationType
  /** Trust ladder for org-level KYC (badge). Distinct from listing verification. */
  verificationStatus ListingVerificationStatus @default(UNVERIFIED)
  /** Admin KYC workflow — PENDING / VERIFIED / REJECTED (Agent verification). */
  kycStatus              OrganizationKycStatus @default(PENDING)
  kycDecisionReason      String? @db.Text
  kycReviewedAt          DateTime?
  kycReviewedByUserId    String?
  identityVerifiedAt     DateTime?
  organizationVerifiedAt DateTime?
  /** Current B2B PricingPlan key (agent_free, agent_pro, …). */
  planKey     String @default("agent_free")
  planStatus  OrganizationPlanStatus @default(ACTIVE)
  pricingPlanId String?
  planPeriodStart DateTime?
  planPeriodEnd   DateTime?
  /** Denormalized from PricingPlan.limits for fast gate checks. */
  listingsLimit Int @default(5)
  seatsLimit    Int @default(1)
  /**
   * B2B lead monetization — MODE A (PAY_PER_LEAD) or MODE B (SUCCESS_FEE).
   * Controls how QualifiedBuyerLead revenue is recognized.
   */
  leadBillingMode OrganizationLeadBillingMode @default(PAY_PER_LEAD)
  /** MODE A: gross price per delivered/accepted qualified lead (haléře). */
  payPerLeadPriceMinor Int @default(49900)
  /** MODE B: Majetio share of broker's actual commission (basis points, 1000 = 10%). */
  successFeeBps Int @default(1000)
  /** Attribution window in days — competing sources inside window → manual review. */
  attributionWindowDays Int @default(30)
  billingEmail  String?
  ico           String?
  dic           String?
  website       String?
  /**
   * Explicit MarketCode for the tenant (B2B org operates in one primary market).
   * Never derive from billing currency alone.
   */
  marketCode    String @default("CZ")
  countryCode   String @default("CZ")
  /** Primary billing / listing currency for the org. */
  currency      String @default("CZK")
  /**
   * Markets the org may operate in (multi-select). Includes primary marketCode.
   */
  marketCoverage String[] @default(["CZ"])
  /**
   * Service line: AGENCY | BROKER | DEVELOPER | MIXED | OTHER
   */
  serviceType   String @default("AGENCY")
  meta          Json?
