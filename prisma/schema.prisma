/**
 * Dispute workflow — agent cannot void a billable lead without evidence.
 * Opening without evidence → EVIDENCE_REQUIRED (lead stays billable).
 */
model LeadDispute {
  id                   String            @id @default(cuid())
  organizationId       String
  qualifiedBuyerLeadId String
  openedByUserId       String
  status               LeadDisputeStatus @default(OPEN)
  reason               LeadDisputeReason
  agentStatement       String            @db.Text
  evidenceRequired     Boolean           @default(true)
  evidenceSubmittedAt  DateTime?
  evidenceMeta         Json?
  reviewNotes          String?           @db.Text
  resolvedAt           DateTime?
  resolvedByUserId     String?
  /** When UPHELD, linked RevenueEvent may be reversed. */
  revenueEventId       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qualifiedBuyerLead QualifiedBuyerLead @relation(fields: [qualifiedBuyerLeadId], references: [id], onDelete: Cascade)
  openedBy           User               @relation("LeadDisputeOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolvedBy         User?              @relation("LeadDisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([qualifiedBuyerLeadId, status])
  @@index([openedByUserId, createdAt])
  @@index([status, createdAt])
}

/**
 * Paid listing Boost — sponsored placement only.
 *
 * FIREWALL (non-negotiable):
 * - Does NOT mutate Majetio Score, valuation, risk analysis, or organic ORDER BY.
 * - Search must expose boosts only via `sponsoredPlacements` (never mixed into organic rank).
 * - Every public render must carry label "Sponzorováno".
 */
model ListingBoost {
