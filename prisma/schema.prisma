  listingReports  ListingReport[]
  marketplaceModeInterests MarketplaceModeInterest[]
  auctionConfigs  AuctionConfig[]
  investmentSnapshot PropertyInvestmentSnapshot?

  @@index([status, visibility])
  @@index([propertyType, transactionType])
  @@index([askingPrice])
  @@index([pricePerSqm])
  @@index([publicCity])
  @@index([publicCity, publicDistrict])
  @@index([publicRegion])
  @@index([locationId])
  @@index([latitude, longitude])
  @@index([status, askingPrice])
  @@index([status, publicCity, askingPrice])
  @@index([freshness, lastSeenAt])
  @@index([transactionType, status, askingPrice])
  @@index([isDemo])
  @@index([ownerUserId])
