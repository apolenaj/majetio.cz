/**
 * MODE B — success fee from broker's actual commission on a closed deal.
 * Lifecycle: POTENTIAL → PENDING_VERIFICATION → VERIFIED → INVOICED → PAID
 * (or DISPUTED / CANCELLED / WRITTEN_OFF).
 */
model SuccessFeeRecord {
  id                    String           @id @default(cuid())
  organizationId        String
  qualifiedBuyerLeadId  String?
  propertyId            String?
  agentUserId           String?
  status                SuccessFeeStatus @default(POTENTIAL)
  /** Actual broker commission (gross, haléře) — claimed then verified. */
  brokerCommissionGrossMinor Int
  /** Snapshot of org successFeeBps at creation. */
  feeBps                Int
  /** Majetio fee = round(brokerCommission * feeBps / 10000). */
  feeAmountMinor        Int
  currency              String           @default("CZK")
  /** Evidence of closed deal / commission (refs only — no PAN). */
  evidenceMeta          Json?
  verifiedAt            DateTime?
  verifiedByUserId      String?
  invoicedAt            DateTime?
  invoiceRef            String?
  paidAt                DateTime?
  /** Link to canonical ledger row once recognized. */
  revenueEventId        String?          @unique
  notes                 String?          @db.Text
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qualifiedBuyerLead QualifiedBuyerLead? @relation(fields: [qualifiedBuyerLeadId], references: [id], onDelete: SetNull)
  verifiedBy         User?              @relation("SuccessFeeVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  revenueEvent       RevenueEvent?      @relation(fields: [revenueEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([qualifiedBuyerLeadId])
  @@index([status, verifiedAt])
}

/**
 * Canonical revenue ledger — subscriptions, analyses, leads, mortgages, boosts.
 * Double-count guard: unique (sourceType, sourceEntityId) + idempotencyKey.
 */
model RevenueEvent {
  id               String                @id @default(cuid())
  /** Client/server idempotency token (e.g. ppl:{leadId}, fee:{successFeeId}). */
  idempotencyKey   String                @unique
  sourceType       RevenueEventSourceType
  sourceEntityType String
  sourceEntityId   String
  organizationId   String?
  userId           String?
  amountGrossMinor Int
  currency         String                @default("CZK")
  status           RevenueEventStatus    @default(PENDING)
  recognizedAt     DateTime?
  reversedAt       DateTime?
  reverseReason    String?
  /** Optional link to Order / Payment for commerce events. */
  orderId          String?
  meta             Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  successFee   SuccessFeeRecord?

  @@unique([sourceType, sourceEntityId])
  @@index([organizationId, status, recognizedAt])
  @@index([sourceType, status, createdAt])
  @@index([orderId])
}

/**
 * Lead attribution inside a configurable window.
