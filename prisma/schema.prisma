model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  granted   Boolean
  version   String
  grantedAt DateTime?
  revokedAt DateTime?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/** Catalog of legal / consent document versions (terms, privacy, …). */
model ConsentVersion {
  id            String      @id @default(cuid())
  type          ConsentType
  version       String
  title         String
  summary       String?     @db.Text
  documentUrl   String?
  effectiveFrom DateTime    @default(now())
  isCurrent     Boolean     @default(false)
  /** Market scope — CZ vs AE privacy packs (Prompt 17.5). */
  marketCode    String      @default("CZ")
  locale        String      @default("cs-CZ")
  createdAt     DateTime    @default(now())

  @@unique([type, version, marketCode])
  @@index([type, isCurrent])
  @@index([marketCode, type, isCurrent])
}

/**
 * Versioned legal document bodies (terms / privacy / cookies).
 * Production source of truth for published legal text; UI falls back to content modules if empty.
 */
enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIES
  LEGAL_NOTICE
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LegalDocument {
  id            String              @id @default(cuid())
  type          LegalDocumentType
  version       String
  status        LegalDocumentStatus @default(DRAFT)
  title         String
  /** Markdown / structured plain text — counsel-owned content. */
  content       String              @db.Text
  summary       String?             @db.Text
  locale        String              @default("cs-CZ")
  marketCode    String              @default("CZ")
  effectiveFrom DateTime?
  publishedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([type, version, marketCode, locale])
  @@index([type, status, marketCode])
  @@index([status, publishedAt])
}

/**
 * Purpose-scoped consent ledger (cookies, partner share, legal).
 * Complements legacy `Consent` rows — new flows should prefer ConsentRecord.
 * Never use generic “souhlasím s partnery”: recipient + purpose required for PARTNER_DATA_SHARE.
 */
enum ConsentPurpose {
  COOKIE_NECESSARY
  COOKIE_PREFERENCES
  COOKIE_ANALYTICS
  COOKIE_MARKETING
  MARKETING_COMMUNICATION
  PARTNER_DATA_SHARE
  LEGAL_TERMS
  LEGAL_PRIVACY
}

model ConsentRecord {
  id              String         @id @default(cuid())
  userId          String?
  /** Anonymous CMP visitor — hashed / opaque; never an email. */
  visitorId       String?
  purpose         ConsentPurpose
  /** Exact recipient legal name for PARTNER_DATA_SHARE; null = Majetio first-party. */
  recipient       String?
  /** Field-level / category scope, e.g. ["monthlyIncomeCzk","phone"]. */
  sharedScope     Json?
  version         String
  granted         Boolean
  grantedAt       DateTime?
  revokedAt       DateTime?
  /** Links to LegalDocument.version or cookie policy version. */
  legalDocVersion String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([visitorId, purpose, createdAt])
  @@index([purpose, granted, createdAt])
  @@index([recipient, createdAt])
}

/**
 * One-time authenticated data export — no public CDN URL with payload.
 * Download requires session userId match + unused unexpired token.
 */
enum PrivacyExportStatus {
  PENDING
  READY
  CONSUMED
  EXPIRED
  FAILED
}

model PrivacyExportToken {
  id           String              @id @default(cuid())
  userId       String
  /** SHA-256 of one-time download token (plaintext shown once). */
  tokenHash    String              @unique
  format       String              @default("json")
  status       PrivacyExportStatus @default(READY)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

/**
 * Programmatic / legal SEO documents with review expiry (Prompt 17.5).
 */
model ProgrammaticSeoDocument {
  id                String    @id @default(cuid())
  kind              String
  marketCode        String
  path              String
  hasRealData       Boolean   @default(false)
  sampleCount       Int?
  publishedAt       DateTime?
  reviewRequiredAt  DateTime?
  lastReviewedAt    DateTime?
  isDemo            Boolean   @default(false)
  title             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([marketCode, path])
  @@index([marketCode, kind])
  @@index([reviewRequiredAt])
}

/** Property search / listing preferences (onboarding Part 2+). */
model PropertyPreference {
  id             String         @id @default(cuid())
  userId         String         @unique
  propertyTypes  PropertyType[]
  minPriceCzk    Int?
  maxPriceCzk    Int?
  minAreaSqm     Float?
  maxAreaSqm     Float?
  preferredCity  String?
  regions        String[]
  dispositions  String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Investment strategy preferences (onboarding Part 2+). */
model InvestmentPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  strategies              String[]
  targetGrossYieldPct     Float?
  targetCashFlowMonthlyCzk Int?
  maxRiskLevel            String?
  holdPeriodYears         Int?
  financingPreferred      Boolean?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Brute-force protection for auth endpoints.
 * Key is typically "ip:email" or "ip".
 */
model AuthRateLimit {
  id          String    @id @default(cuid())
  key         String    @unique
  failCount   Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ─── Properties & locations ──────────────────────────────────────────────────

model Location {
  id             String                  @id @default(cuid())
  type           LocationType            @default(MUNICIPALITY)
  parentId       String?
  countryCode    String                  @default("CZ")
  name           String
  slug           String                  @unique
  /** Public-facing label, e.g. "Praha 2 – Vinohrady". */
  publicLabel    String?
  /** Primary official identifier (RÚIAN / LAU / NUTS when unambiguous). */
  officialCode   String?
  ruianCode      String?
  lauCode        String?
  nutsCode       String?
  latitude       Float?
  longitude      Float?
  centroidLat    Float?
  centroidLon    Float?
  /** GeoJSON Polygon/MultiPolygon — use until PostGIS extension is enabled. */
  boundary       Json?
  boundaryFormat LocationBoundaryFormat  @default(GEOJSON)
  population     Int?
  areaSqKm       Float?
  /** @deprecated Prefer publicLabel. */
  publicName     String?
  /** @deprecated Denormalized — prefer parent hierarchy. Kept for legacy queries. */
  region         String?
  /** @deprecated Denormalized — prefer parent hierarchy. */
  district       String?
  /** @deprecated Denormalized — prefer parent hierarchy. */
  city           String?
  /** @deprecated Prefer countryCode. */
  country        String                  @default("CZ")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  parent     Location?        @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Location[]       @relation("LocationHierarchy")
  metrics         LocationMetric[]
  metricHistory   LocationMetricHistory[]
  marketSnapshots LocationMarketSnapshot[]
  qualityIssues   DataQualityIssue[]
  fallbackMetrics LocationMetric[] @relation("MetricFallbackSource")
  properties Property[]

  @@index([type, countryCode])
  @@index([parentId])
  @@index([officialCode])
  @@index([ruianCode])
  @@index([lauCode])
  @@index([nutsCode])
  @@index([countryCode, name])
  @@index([centroidLat, centroidLon])
  @@unique([type, countryCode, slug])
}

/**
 * Registered external / internal feed for Location Intelligence ingestion.
 */
model LocationDataSource {
  id              String                      @id @default(cuid())
  name            String
  /** Stable key, e.g. cz_ruian_boundaries, partner_listings_feed */
  key             String                      @unique
  category        LocationDataSourceCategory
  /** URL or internal reference identifier. */
  urlOrReference  String?
  license         String?
  updateFrequency LocationDataUpdateFrequency @default(MONTHLY)
  lastUpdated     DateTime?
  /** 0–1 reliability prior used in confidence blending. */
  reliability     Float                       @default(0.7)
  /** JSON policy: { display: true, commercial: false, derivative: true } */
  allowedUsage    Json?
  active          Boolean                     @default(true)
  notes           String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  metrics    LocationMetric[]
  ingestionJobs LocationIngestionJob[]

  @@index([category, active])
}

model LocationIngestionJob {
  id              String                    @id @default(cuid())
  dataSourceId    String
  status          LocationIngestionJobStatus @default(PENDING)
  period          String?
  startedAt       DateTime?
  finishedAt      DateTime?
  recordsFetched  Int                       @default(0)
  recordsStored   Int                       @default(0)
  errorMessage    String?
  stageLog        Json?
  methodologyVersion String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  dataSource LocationDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId, status])
  @@index([createdAt])
}

model LocationMetric {
  id                   String                    @id @default(cuid())
  locationId           String
  /** Registry key, e.g. property_market.median_price_sqm */
  metricKey            String
  category             LocationMetricCategory
  /** Primary value — for price metrics this is the MEDIAN. */
  value                Float
  unit                 String?
  /** Period label: 2026-07, 2026-Q2, trailing_12m, … */
  period               String
  source               String?
  sourceType           LocationMetricSourceType  @default(INTERNAL_AGGREGATION)
  priceKind            LocationMetricPriceKind   @default(NONE)
  /** Encoded segment dimensions — never mix segments in one row. */
  segmentKey           String                    @default("_all")
  segment              Json?
  sampleCount          Int?
  meanValue            Float?
  lowerQuartile        Float?
  upperQuartile        Float?
  confidence           Float?
  /** Source feed quality band. */
  sourceQuality        LocationSourceQuality     @default(UNKNOWN)
  freshness            LocationMetricFreshness   @default(UNKNOWN)
  /** Anomaly pipeline flagged for analyst review. */
  reviewRequired       Boolean                   @default(false)
  /** When metric was inherited from coarser geography (fallback hierarchy). */
  fallbackFromLocationId String?
  dataSourceId         String?
  methodologyVersion   String
  calculatedAt         DateTime
  validFrom            DateTime
  validTo              DateTime?
  publishedAt          DateTime?
  /** @deprecated Use calculatedAt. Kept for legacy readers. */
  recordedAt           DateTime                  @default(now())

  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fallbackFromLocation Location?         @relation("MetricFallbackSource", fields: [fallbackFromLocationId], references: [id], onDelete: SetNull)
  dataSource         LocationDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  history            LocationMetricHistory[]

  @@unique([locationId, metricKey, period, segmentKey, priceKind, validFrom])
  @@index([locationId, category, metricKey])
  @@index([locationId, period])
  @@index([metricKey, period])
  @@index([validFrom, validTo])
  @@index([freshness, reviewRequired])
  @@index([dataSourceId])
  @@index([locationId, metricKey, period])
  @@index([calculatedAt])
  @@index([segmentKey, period])
  @@index([publishedAt])
}

/**
 * Point-in-time market snapshot for historical analysis / audits.
 * Stores selected metric values + methodology versions — never invents missing series.
 */
model LocationMarketSnapshot {
  id                   String   @id @default(cuid())
  locationId           String
  period               String
  /** Selected metrics map: { metricKey: { value, sampleCount, confidence, ... } } */
  selectedMetrics      Json
  /** methodologyVersion per metricKey */
  methodologyVersions  Json
  segmentKey           String   @default("_all")
  /** Explicit UI signal when any metric used parent geography. */
  usedFallback         Boolean  @default(false)
  fallbackNotes        String?
  calculatedAt         DateTime
  publishedAt          DateTime?
  createdAt            DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, period, segmentKey, calculatedAt])
  @@index([locationId, period])
  @@index([locationId, segmentKey, period])
  @@index([calculatedAt])
}

/** Historical points for trend charts — append-only series. */
model LocationMetricHistory {
  id                 String                    @id @default(cuid())
  locationId         String
  locationMetricId   String?
  metricKey          String
  category           LocationMetricCategory
  priceKind          LocationMetricPriceKind   @default(NONE)
  segmentKey         String                    @default("_all")
  period             String
  value              Float
  unit               String?
  sampleCount        Int?
  meanValue          Float?
  lowerQuartile      Float?
  upperQuartile      Float?
  confidence         Float?
  methodologyVersion String
  calculatedAt       DateTime
  validFrom          DateTime
  validTo            DateTime?

  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationMetric LocationMetric? @relation(fields: [locationMetricId], references: [id], onDelete: SetNull)

  @@index([locationId, metricKey, segmentKey, priceKind, calculatedAt])
  @@index([locationId, period])
  @@index([metricKey, calculatedAt])
}

/**
 * Canonical property — multi-source listing subject.
 * Exact address fields are internal; public surfaces must respect addressPrecision + visibility.
 */
model Property {
  id            String             @id @default(cuid())
  slug          String             @unique
  /** Stable cross-source identity key (Part 2+ dedup). */
  canonicalKey  String             @unique
  status        PropertyStatus     @default(DRAFT)
  visibility    PropertyVisibility @default(PUBLIC)
  transactionType TransactionType  @default(SALE)
  publishedAt   DateTime?
  /** Lifecycle — multi-source freshness (stale when source silent). */
  firstSeenAt   DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  lastFetchedAt DateTime?
  freshness     PropertyFreshness  @default(FRESH)
  staleMarkedAt DateTime?
  /** Demo / seed listings — never treated as live market offers. */
  isDemo        Boolean            @default(false)
  /** Owner for PRIVATE / ACCOUNT_ONLY access checks (IDOR guard). */
  ownerUserId   String?
  /**
   * B2B listing owner — agency / developer / agent org that publishes the offer.
   * Consumer favourites still use ownerUserId for private workspace.
   */
  organizationId String?
  /** Agent user who created / manages the listing inside the org. */
  listedByUserId String?
  listingOwnerKind ListingOwnerKind?
  listingVerificationStatus ListingVerificationStatus @default(UNVERIFIED)
  /**
   * Downgrade safety: listings above plan quota become OVER_LIMIT (not deleted).
   * Public discovery should exclude OVER_LIMIT until upgraded or archived by user.
   */
  listingQuotaState ListingQuotaState @default(WITHIN_LIMIT)
  overLimitAt       DateTime?
  overLimitReason   String?
  /** Moderation — BANNED cannot appear in discovery or paid boost. */
  listingModerationStatus ListingModerationStatus @default(CLEAR)
  /**
   * Ops / agent review notes (REJECT / SUSPEND / REQUEST_CHANGES).
   * Internal — not always equal to userFacingModerationMessage.
   */
  moderationReason String? @db.Text
  /** Safe explanation shown to listing owner / agent. */
  userFacingModerationMessage String? @db.Text
  moderatedAt      DateTime?
  moderatedByUserId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // ── Basics ───────────────────────────────────────────────────────────────
  title            String
  description      String?            @db.Text
  propertyType     PropertyType
  condition        PropertyCondition  @default(UNKNOWN)
  constructionType ConstructionType  @default(UNKNOWN)
  ownershipType    OwnershipType      @default(UNKNOWN)
  /** Cross-market legal tenure (FREEHOLD / LEASEHOLD / …). */
  tenureType       CanonicalTenureType @default(UNKNOWN)
  /** Market registry code (CZ, AE, …) — multi-market Core. Explicit — never from currency. */
  marketCode       String             @default("CZ")
  /** ISO 3166-1 alpha-2 — usually equals marketCode; kept explicit for multi-country markets. */
  countryCode      String             @default("CZ")
  /**
   * Primary new-build vs secondary resale (Prompt 17.3).
   * Prefer explicit channel over inferring from condition alone.
   */
  listingMarketChannel ListingMarketChannel @default(SECONDARY_RESALE)
  /** True when unit is sold before / during construction (off-plan). */
  isOffPlan        Boolean            @default(false)
  constructionStatus OffPlanConstructionStatus @default(UNKNOWN)
  /** Expected handover / completion (date or end-of-month). */
  expectedCompletion DateTime?
  developerName    String?
  projectName      String?
  /** 0–100 when known. */
  constructionProgressPct Int?

  // ── Price ────────────────────────────────────────────────────────────────
  askingPrice         Int?
  originalAskingPrice Int?
  /** @deprecated Prefer askingPrice — kept for existing readers. */
  priceCzk            Int?
  currency            String  @default("CZK")
  pricePerSqm         Float?
  negotiable          Boolean @default(false)

  // ── Size & layout ────────────────────────────────────────────────────────
  usableArea   Float?
  floorArea    Float?
  landArea     Float?
  /** @deprecated Prefer usableArea. */
  areaSqm      Float?
  layout       String?
  /** @deprecated Prefer layout (e.g. 3+kk). */
  disposition  String?
  roomsCount   Int?
  bedroomsCount Int?
  bathroomsCount Int?

  // ── Building ─────────────────────────────────────────────────────────────
  floor           Int?
  floorsTotal     Int?
  yearBuilt       Int?
  yearRenovated   Int?
  energyRating    EnergyRating @default(UNKNOWN)
  parkingSpaces   Int?
  hasElevator     Boolean?
  buildingName    String?

  // ── Public location (safe to show when precision allows) ─────────────────
  publicLabel      String?
  addressPrecision AddressPrecision @default(APPROXIMATE)
  publicCity       String?
  publicDistrict   String?
  publicRegion     String?

  // ── Internal / precise location (not for public by default) ──────────────
  street             String?
  houseNumber        String?
  orientationNumber  String?
  zip                String?
  /** Internal city (may equal publicCity). */
  city               String?
  latitude           Float?
  longitude          Float?
  locationId         String?
  /** How precisely property was matched to `locationId` — never inflate beyond input. */
  locationResolutionConfidence LocationResolutionConfidence?
  /** Resolution audit: matched levels, warnings, resolver version. */
  locationResolutionMeta     Json?

  location        Location?               @relation(fields: [locationId], references: [id])
  owner           User?                   @relation("PropertyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  listedBy        User?                   @relation("PropertyListedBy", fields: [listedByUserId], references: [id], onDelete: SetNull)
  features        PropertyFeatures?
  attributes      PropertyAttribute[]
  /**
   * Validated market-specific bag (Zod Typed Extensions).
   * Shape depends on marketCode — never dump foreign-market keys.
   * See docs/INTERNATIONAL_PROPERTY_MODEL.md.
   */
  marketExtensions Json?
  localizedTexts  PropertyLocalizedText[]
  fieldProvenance PropertyFieldProvenance[]
  sources         PropertySource[]
  media           PropertyMedia[]
  /** @deprecated Prefer PropertyMedia. */
  images          PropertyImage[]
  priceHistory    PropertyPriceHistory[]
  statusHistory   PropertyStatusHistory[]
  duplicateAsA    PropertyDuplicateCandidate[] @relation("DuplicatePropertyA")
  duplicateAsB    PropertyDuplicateCandidate[] @relation("DuplicatePropertyB")
  mergeTargets    PropertyDuplicateCandidate[] @relation("DuplicateMergeTarget")
  qualityIssues   DataQualityIssue[]
