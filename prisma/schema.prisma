  action        String
  /** Never store the price value here — only field names accessed. */
  fieldsAccessed String[]
  ip            String?
  createdAt     DateTime @default(now())

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@index([actorUserId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?             @db.Text
  readAt    DateTime?
  meta      Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
  ANONYMOUS
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  /** USER | SYSTEM | SERVICE | ANONYMOUS — never store credentials. */
  actorType      AuditActorType @default(USER)
  action         String
  /** Legacy entity name — keep for existing readers; prefer entityType. */
  entity         String
  entityType     String?
  entityId       String?
  reason         String?  @db.Text
  /** Redacted human-readable before state — never secrets/tokens. */
  beforeSummary  String?  @db.Text
  /** Redacted human-readable after state — never secrets/tokens. */
  afterSummary   String?  @db.Text
  correlationId  String?
  ip             String?
  userAgent      String?
  /**
   * Optional structured meta — MUST be pre-sanitized (no secrets).
   * Append-only table: updates/deletes blocked at DB + app layer.
   */
  meta           Json?
  createdAt      DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId])
  @@index([actorType, createdAt])
  @@index([correlationId])
  @@index([action, createdAt])
  @@index([entityType, action, createdAt])
}

model AppConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  /** BUSINESS_LIMIT | FEATURE | OPERATIONAL — never store raw secrets here. */
  category    String   @default("BUSINESS_LIMIT")
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

