 * Every metric is nullable — a missing calculation stays NULL, never a placeholder.
 */
model PropertyInvestmentSnapshot {
  id                            String    @id @default(cuid())
  propertyId                    String    @unique
  grossYieldPct                 Float?
  netYieldPct                   Float?
  estimatedRentMonthlyCzk       Int?
  rentPerSqm                    Float?
  monthlyCashflowCzk            Int?
  cashOnCashPct                 Float?
  paybackYears                  Float?
  renovationCostMinCzk          Int?
  renovationCostMaxCzk          Int?
  renovationLevel               String?
  yieldAfterRenovationPct       Float?
  allInCostCzk                  Int?
  estimatedValueMinCzk          Int?
  estimatedValueMaxCzk          Int?
  discountToEstimatedValuePct   Float?
  tenantDemandScore             Int?
  estimatedOccupancyMinPct      Float?
  estimatedOccupancyMaxPct      Float?
  estimatedVacancyDaysPerYear   Int?
  investmentRisk                String?
  locationRisk                  String?
  tenantRisk                    String?
  renovationRisk                String?
  financialRisk                 String?
  dataRisk                      String?
