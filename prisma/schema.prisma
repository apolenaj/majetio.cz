  purchasedBy  User          @relation("ListingBoostPurchaser", fields: [purchasedByUserId], references: [id], onDelete: Cascade)

  @@index([propertyId, status, endsAt])
  @@index([status, startsAt, endsAt])
  @@index([organizationId, status])
  @@index([orderId])
  @@index([productKey, status])
}

/**
