// ─── International markets (Prompt 17.1) ─────────────────────────────────────

/**
 * Launch lifecycle for a market. Public UI may only treat BETA|LIVE as active
 * (and only when enabled + hasMinimumPublicData).
 */
enum MarketLaunchStatus {
  PLANNED
  RESEARCH
  BETA
  LIVE
  PAUSED
}

enum MarketMeasurementSystem {
  METRIC
  IMPERIAL
}

/**
 * Optional DB mirror of MarketRegistry for ops overrides.
 * Code plugins remain source of truth for definitions / capabilities.
 */
model Market {
  id                       String                  @id @default(cuid())
  marketCode               String                  @unique
  countryCode              String
  displayNameEn            String
  displayNameLocal         String
  defaultLocale            String
  supportedLocales         String[]                @default([])
  defaultCurrency          String
  timezone                 String
  measurementSystem        MarketMeasurementSystem @default(METRIC)
  enabled                  Boolean                 @default(false)
  launchStatus             MarketLaunchStatus      @default(PLANNED)
  regulatoryConfigVersion  String
  hasMinimumPublicData     Boolean                 @default(false)
  /**
   * Kill-switch snapshot (also mirrored in process store for hot path).
   * { pauseNewListings, pauseValuations, pauseLeadRouting, reviewRequired, … }
   */
  killSwitch               Json?
  /** Optional JSON: regions[], notes, feature overrides. */
  metadata                 Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([launchStatus, enabled])
  @@index([countryCode])
}

/**
 * Persisted FX observation (Prompt 17.2).
 * Calculations must copy/freeze a snapshot — never re-read live rates for history.
 */
model ExchangeRateSnapshot {
  id             String   @id @default(cuid())
  baseCurrency   String
  quoteCurrency  String
  /** Decimal string — units of quote per 1 base. */
  rate           String
  source         String
  /** UTC instant when observed. */
  observedAt     DateTime
  providerRef    String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, observedAt, source])
  @@index([baseCurrency, quoteCurrency, observedAt])
  @@index([observedAt])
}

/**
 * Versioned regulatory rule (Prompt 17.4).
 * Code packs seed runtime; this table supports admin overrides.
 */
model RegulatoryRule {
  id                              String                @id @default(cuid())
  code                            String
  marketCode                      String
  kind                            RegulatoryRuleKind
  version                         String
  status                          RegulatoryRuleStatus  @default(DRAFT)
  validFrom                       DateTime
  validTo                         DateTime?
  verifiedAt                      DateTime?
  verifiedBy                      String?
  titleEn                         String
  summaryEn                       String                @db.Text
  payload                         Json
  requiresLegalVerificationNotice Boolean               @default(true)
  /** When set and past due → admin attention queue (stale regulation). */
  reviewRequiredAt                DateTime?
  sourceUrl                       String?
  sourceLabel                     String?
  /** Demo / research — excluded from production resolution unless allowDemo. */
  isDemo                          Boolean               @default(false)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  @@unique([marketCode, code, version])
  @@index([marketCode, kind, status])
  @@index([validFrom, validTo])
  @@index([isDemo])
  @@index([reviewRequiredAt])
}

/**
 * Versioned market due-diligence checklist pack (Rules 153–154).
 */
model DueDiligenceChecklistPack {
  id          String    @id @default(cuid())
  marketCode  String
  version     String
  titleEn     String
  reviewedAt  DateTime?
  reviewedBy  String?
  isDemo      Boolean   @default(false)
  /** JSON array of DueDiligenceChecklistItem. */
  items       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([marketCode, version])
  @@index([marketCode, isDemo])
  @@index([reviewedAt])
}

/** Off-plan developer payment plan (Prompt 17.4). */
model PropertyPaymentPlan {
  id               String   @id @default(cuid())
  propertyId       String?
  marketCode       String
  currency         String
  totalPriceMinor  BigInt
  developerName    String?
  projectName      String?
  version          String   @default("1")
  fxSnapshotId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property Property?                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  phases   PropertyPaymentPlanPhase[]

  @@index([propertyId])
  @@index([marketCode])
}

model PropertyPaymentPlanPhase {
  id                      String               @id @default(cuid())
  planId                  String
  kind                    PaymentPlanPhaseKind
  labelEn                 String
  sequence                Int
  amountBps               Int                  @default(0)
  amountMinorOverride     BigInt?
  dueDate                 DateTime?
  constructionPctTrigger  Int?
  notesEn                 String?
  createdAt               DateTime             @default(now())

  plan PropertyPaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sequence])
}

/** Financing partner catalog (Prompt 17.4). */
model FinancingProvider {
  id                        String                @id @default(cuid())
  code                      String                @unique
  displayNameEn             String
  marketCodes               String[]
  kind                      FinancingProviderKind @default(UNAVAILABLE)
  leadHandoffEnabled        Boolean               @default(false)
  ratePackId                String?
  regulatoryConfigVersion   String?
  notesEn                   String?               @db.Text
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([isActive])
}

// ─── Platform governance (Prompt 6) ──────────────────────────────────────────

enum FeatureFlagScope {
  GLOBAL
  MARKET
  USER_PERCENTAGE
}

/**
 * Centralized feature flags + kill switches.
 * Kill switches: isKillSwitch=true (payments, listings, valuation, markets).
 */
model FeatureFlag {
  id             String           @id @default(cuid())
  key            String
  scope          FeatureFlagScope @default(GLOBAL)
  /** Empty string for GLOBAL / USER_PERCENTAGE (Postgres unique + NULL). */
  marketCode     String           @default("")
  /** 0–100 when scope = USER_PERCENTAGE */
  percentage     Int?
  enabled        Boolean          @default(false)
  isKillSwitch   Boolean          @default(false)
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  changes FeatureFlagChange[]

  @@unique([key, scope, marketCode])
  @@index([isKillSwitch, enabled])
  @@index([scope, marketCode])
  @@index([key])
}

model FeatureFlagChange {
  id           String   @id @default(cuid())
  featureFlagId String
  actorUserId  String?
  reason       String   @db.Text
  oldEnabled   Boolean
  newEnabled   Boolean
  oldValueJson Json?
  newValueJson Json?
  createdAt    DateTime @default(now())

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@index([featureFlagId, createdAt])
  @@index([actorUserId, createdAt])
}

enum CmsContentKind {
  GUIDE
  FAQ
  METHODOLOGY
  REGULATORY
}

enum CmsContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum ContentTranslationStatus {
  MACHINE_DRAFT
  REVIEWED
  APPROVED
}

/** Lightweight in-app CMS when no external CMS is wired. */
model CmsContent {
  id                String          @id @default(cuid())
  slug              String
  kind              CmsContentKind
  status            CmsContentStatus @default(DRAFT)
  title             String
  bodyMarkdown      String           @db.Text
  marketCode        String           @default("CZ")
  locale            String           @default("cs-CZ")
  /** Regulatory / financial copy must declare source. */
  isRegulatory      Boolean          @default(false)
  sourceLabel       String?
  sourceUrl         String?
  reviewRequiredAt  DateTime?
  lastReviewedAt    DateTime?
  publishedAt       DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  translations ContentTranslation[]

  @@unique([slug, locale, marketCode])
  @@index([status, kind])
  @@index([isRegulatory, reviewRequiredAt])
  @@index([marketCode, status])
}

model ContentTranslation {
  id              String                   @id @default(cuid())
  contentId       String
  locale          String
  status          ContentTranslationStatus @default(MACHINE_DRAFT)
  title           String
  bodyMarkdown    String                   @db.Text
  reviewedAt      DateTime?
  reviewedByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  content CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, locale])
  @@index([status])
}

enum IncidentCategory {
  DATA
  SECURITY
  PAYMENTS
  AVAILABILITY
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PlatformIncident {
  id              String           @id @default(cuid())
  title           String
  summary         String           @db.Text
  category        IncidentCategory
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  marketCode      String?
  openedByUserId  String?
  ownerUserId     String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, severity])
  @@index([category, status])
  @@index([createdAt])
}

// ─── Ops Control Center — Incident / Audit / Dataset (126–138, 218–227) ─────

/**
 * Incident severity (spec 126–131). SEV1 = highest urgency.
 * Distinct from legacy PlatformIncident.IncidentSeverity (LOW…CRITICAL).
 */
enum IncidentSevLevel {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentOpsStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum IncidentTimelineEventType {
  CREATED
  STATUS_CHANGE
  SEVERITY_CHANGE
  NOTE
  OWNER_CHANGE
  LINK_ADDED
  LINK_REMOVED
  SYSTEM
}

/**
 * Canonical ops Incident (126–131).
 * PlatformIncident remains a lightweight category view; this is the full model.
 */
model Incident {
  id               String            @id @default(cuid())
  title            String
  description      String            @db.Text
  severity         IncidentSevLevel  @default(SEV3)
  status           IncidentOpsStatus @default(OPEN)
  /** Primary owner (ops user id). */
  ownerUserId      String?
  openedByUserId   String?
  startedAt        DateTime          @default(now())
  resolvedAt       DateTime?
  /** System keys affected, e.g. payments, imports, valuation. */
  affectedSystems  String[]          @default([])
  internalNotes    String?           @db.Text
  marketCode       String?
  correlationId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  timeline      IncidentTimelineEvent[]
  linkedEntities IncidentLinkedEntity[]

  @@index([status, severity])
  @@index([ownerUserId, status])
  @@index([startedAt])
  @@index([resolvedAt])
  @@index([correlationId])
  @@index([createdAt])
}

model IncidentTimelineEvent {
  id          String                   @id @default(cuid())
  incidentId  String
  eventType   IncidentTimelineEventType @default(NOTE)
  /** Actor who recorded the event (nullable for SYSTEM). */
  actorUserId String?
  message     String                   @db.Text
  /** Redacted payload — no secrets. */
  meta        Json?
  occurredAt  DateTime                 @default(now())
  createdAt   DateTime                 @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
  @@index([eventType, occurredAt])
}

model IncidentLinkedEntity {
  id         String   @id @default(cuid())
  incidentId String
  entityType String
  entityId   String
  label      String?
  linkedAt   DateTime @default(now())
  linkedByUserId String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([incidentId])
}

enum DatasetHealthStatus {
  HEALTHY
  STALE
  DEGRADED
  DISABLED
}

enum DatasetUpdateFrequency {
  REALTIME
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
  UNKNOWN
}

/**
 * Dataset Registry — governance metadata (218–227).
 */
model DatasetRegistry {
  id                 String                 @id @default(cuid())
  /** Stable machine key, e.g. properties.canonical, fx.ecb */
  key                String                 @unique
  name               String
  description        String?                @db.Text
  ownerUserId        String?
  stewardUserId      String?
  /** Source system / provider label (not credentials). */
  source             String
  sourceRef          String?
  updateFrequency    DatasetUpdateFrequency @default(UNKNOWN)
  /** Max acceptable staleness in minutes for SLA. */
  qualitySlaMinutes  Int?
  /** Target DQ score 0–100. */
  qualitySlaScoreMin Float?
  healthStatus       DatasetHealthStatus    @default(HEALTHY)
  lastRefreshedAt    DateTime?
  marketCode         String?
  tags               String[]               @default([])
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  qualityScores DatasetQualityScore[]
  upstreamOf    DatasetLineage[] @relation("LineageUpstream")
  downstreamOf  DatasetLineage[] @relation("LineageDownstream")

  @@index([healthStatus])
  @@index([ownerUserId])
  @@index([stewardUserId])
  @@index([source])
  @@index([lastRefreshedAt])
  @@index([marketCode, healthStatus])
}

model DatasetQualityScore {
  id              String   @id @default(cuid())
  datasetId       String
  /** Overall 0–100. */
  score           Float
  completeness    Float?
  freshness       Float?
  consistency     Float?
  validity        Float?
  sampleSize      Int?
  notes           String?  @db.Text
  scoredAt        DateTime @default(now())
  scoredByUserId  String?
  metrics         Json?

  dataset DatasetRegistry @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, scoredAt])
  @@index([scoredAt])
}

enum DatasetLineageKind {
  DERIVES_FROM
  ENRICHES
  JOINS
  VALIDATES
  MIRRORS
}

/** Directed dependency: upstream → downstream. */
model DatasetLineage {
  id                 String             @id @default(cuid())
  upstreamDatasetId  String
  downstreamDatasetId String
  kind               DatasetLineageKind @default(DERIVES_FROM)
  notes              String?
  createdAt          DateTime           @default(now())

  upstream   DatasetRegistry @relation("LineageUpstream", fields: [upstreamDatasetId], references: [id], onDelete: Cascade)
  downstream DatasetRegistry @relation("LineageDownstream", fields: [downstreamDatasetId], references: [id], onDelete: Cascade)

  @@unique([upstreamDatasetId, downstreamDatasetId, kind])
  @@index([upstreamDatasetId])
  @@index([downstreamDatasetId])
}

// ─── Ops Admin API — notes & assignments (151–155, 182–192) ─────────────────

enum AdminEntityKind {
  PROPERTY
  USER
  ORGANIZATION
  LEAD
  ORDER
  INCIDENT
  DATASET
  IMPORT_JOB
}

enum AdminAssignmentStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/**
 * Private staff notes on any ops entity — never exposed on public DTOs.
 */
model AdminEntityNote {
  id              String          @id @default(cuid())
  entityKind      AdminEntityKind
  entityId        String
  body            String          @db.Text
  authorUserId    String
  isPinned        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([entityKind, entityId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([deletedAt])
}

/**
 * Simple ops assignment (owner / watcher) — not a universal task system.
 */
model AdminAssignment {
  id               String                @id @default(cuid())
  entityKind       AdminEntityKind
  entityId         String
  assigneeUserId   String
  assignedByUserId String
  status           AdminAssignmentStatus @default(OPEN)
  dueAt            DateTime?
  note             String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?

  @@index([assigneeUserId, status])
  @@index([entityKind, entityId, status])
  @@index([assignedByUserId, createdAt])
  @@index([dueAt, status])
}

// ─── System health, jobs, DLQ (139–150, 166–171) ─────────────────────────────

enum SystemComponentKind {
  DATABASE
  QUEUE
  PAYMENTS
  SEARCH
  EXTERNAL_PROVIDER
}

enum SystemComponentHealthStatus {
  UP
  DEGRADED
  DOWN
  UNKNOWN
}

enum SystemJobKind {
  PROPERTY_RECALC
  PROPERTY_EVALUATION
  PROPERTY_MERGE
  MODEL_SHADOW_EVAL
  GENERIC
}

enum SystemJobStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

/**
 * Unified background job row — enqueue returns immediately; workers claim jobs.
 */
model SystemJob {
  id              String          @id @default(cuid())
  kind            SystemJobKind
  status          SystemJobStatus @default(QUEUED)
  priority        Int             @default(100)
  payload         Json
  /** Progress 0–100. */
  progressPct     Int             @default(0)
  attempts        Int             @default(0)
  maxAttempts     Int             @default(5)
  lastError       String?         @db.Text
  rateLimitKey    String?
  scheduledAt     DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  createdByUserId String?
  correlationId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  deadLetters SystemJobDeadLetter[]

  @@index([status, scheduledAt])
  @@index([kind, status])
  @@index([rateLimitKey, createdAt])
  @@index([correlationId])
  @@index([createdAt])
}

model SystemJobDeadLetter {
  id          String   @id @default(cuid())
  jobId       String
  kind        SystemJobKind
  payload     Json
  error       String   @db.Text
  attempts    Int
  failedAt    DateTime @default(now())
  requeuedAt  DateTime?
  meta        Json?

  job SystemJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([kind, failedAt])
  @@index([failedAt])
  @@index([jobId])
}

/** Latest probe result per component (optional cache for dashboards). */
model SystemHealthProbe {
  id           String                      @id @default(cuid())
  component    SystemComponentKind
  /** Provider key for EXTERNAL_PROVIDER, else component name. */
  componentKey String
  status       SystemComponentHealthStatus @default(UNKNOWN)
  latencyMs    Int?
  message      String?
  checkedAt    DateTime                    @default(now())
  meta         Json?

  @@unique([component, componentKey])
  @@index([status, checkedAt])
}

/**
 * Alternative marketplace modes — shared investment, offer-a-price, swap, etc.
 * Status distinguishes declared interest vs confirmed participation vs settled deal.
 * Never treat DECLARED as collected money or legal ownership.
 */
enum MarketplaceModeKind {
  SHARED_INVESTMENT
  PARTIAL_BUY
  SHARED_RENT
  OFFER_PRICE
  SWAP
  HOUSING_HELP
  AUCTION
  FOREIGN_INFO
}

enum MarketplaceInterestStatus {
  DECLARED
  WAITLIST
  ACCEPTED_FOR_NEGOTIATION
  CONFIRMED_PARTICIPATION
  SETTLED
  WITHDRAWN
  REJECTED
}

model MarketplaceModeInterest {
  id           String                     @id @default(cuid())
  propertyId   String?
  mode         MarketplaceModeKind
  userId       String?
  status       MarketplaceInterestStatus  @default(DECLARED)
  /** Requested share % for shared investment (not ownership). */
  sharePct     Float?
  amountMinor  Int?
  currency     String?                    @default("CZK")
  /** Mode-specific payload (counterparty items, rent prefs, etc.). */
  payload      Json?
  message      String?                    @db.Text
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?     @relation("MarketplaceModeInterestUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, mode, status])
  @@index([userId, mode, createdAt])
  @@index([mode, status, createdAt])
}

/**
 * Configurable auction module — not legally activated until rules are decided.
 * Bids are atomic; highest bid ≠ property transfer.
 */
model AuctionConfig {
  id              String   @id @default(cuid())
  propertyId      String
  currency        String   @default("CZK")
  startsAt        DateTime
  endsAt          DateTime
  minIncrement    Int
  reservePrice    Int?
  /** Soft rules blob — bindingness undecided until product decision. */
  rulesMeta       Json?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bids     AuctionBid[]

  @@index([propertyId, status])
  @@index([endsAt, status])
}

model AuctionBid {
  id             String   @id @default(cuid())
  auctionId      String
  bidderUserId   String
  amountMinor    Int
  currency       String   @default("CZK")
  serverReceivedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  auction AuctionConfig @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User          @relation("AuctionBidUser", fields: [bidderUserId], references: [id], onDelete: Cascade)

  @@index([auctionId, amountMinor])
  @@index([bidderUserId, createdAt])
}

/**
 * Non-binding success-fee package engagement — no automatic PSP charge.
 */
enum SuccessFeeEngagementStatus {
  DRAFT
  REQUESTED
  ACCEPTED_NONBINDING
  CANCELLED
}

model SuccessFeeEngagement {
  id           String                     @id @default(cuid())
  userId       String
  propertyId   String?
  actorKind    String
  tier         String
  ratePct      Float
  ratePctMax   Float?
  transaction  String
  status       SuccessFeeEngagementStatus @default(DRAFT)
  notes        String?                    @db.Text
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  user User @relation("SuccessFeeEngagementUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([propertyId])
}
