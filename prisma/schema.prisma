  sponsoredLabel  String @default("Sponzorováno")
  eligibilitySnapshot Json?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
