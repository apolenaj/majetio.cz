# Environment variables for Majetio.cz
# Copy to `.env` or `.env.local` and fill in values.
# Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Majetio
# Production: set to https://www.majetio.cz (never localhost). App refuses localhost in prod-like.
# MAINTENANCE_MODE=true
# Ops: graceful 503 for public traffic; /api/ready, /admin, /prihlaseni still reachable.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/majetio?schema=public

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Optional: set in production to your canonical URL
AUTH_URL=http://localhost:3000

# Credentials provider (email + password). Set to "false" to disable.
AUTH_CREDENTIALS_ENABLED=true

# Secure SUPER_ADMIN bootstrap (scripts/bootstrap-admin.ts) — never public registration.
# ALLOW_ADMIN_BOOTSTRAP=true
# CONFIRM_PROD_ADMIN_BOOTSTRAP=I_UNDERSTAND
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# --- HypotekaJasne integration ---
# Phase 1 uses the mock adapter. Keep disabled until a real API exists.
HYPOTEKAJASNE_ENABLED=false
HYPOTEKAJASNE_API_URL=
HYPOTEKAJASNE_API_KEY=
# Local/dev: mock OK. Production: set USE_MOCK=false + live credentials, or ALLOW_MOCK=true only for staging.
HYPOTEKAJASNE_USE_MOCK=true
# HYPOTEKAJASNE_ALLOW_MOCK=true

# --- Payments (Phase 2 — Core Checkout) ---
# Local: PAYMENTS_PROVIDER=mock. Production: leave "none" until a real PSP is wired.
# Production with mock requires explicit PAYMENTS_ALLOW_MOCK=true (staging only).
# Secrets must never be exposed to the client (see docs/PAYMENTS.md).
PAYMENTS_PROVIDER=none
# PAYMENTS_ALLOW_MOCK=true
PAYMENTS_SECRET_KEY=dev-only-replace-me
PAYMENTS_WEBHOOK_SECRET=dev-only-webhook-secret
PAYMENTS_WEBHOOK_TOLERANCE_SEC=300

# --- Observability (Prompt 20.9) ---
# Optional HTTPS webhook for exceptions (Better Stack / custom). Leave unset = noop in prod.
# ERROR_TRACKER_WEBHOOK_URL=https://example.com/hooks/majetio
# ERROR_TRACKER=console

# --- SEO (Phase 2) ---
# Google Search Console HTML-tag verification token (optional until GSC connected).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Feature flags (checklist 165/166 + legal 213–215) — defaults match FEATURE_FLAG_DEFAULTS ---
# Transaction success fee / Purchase Concierge MUST stay false until legal framework.
TRANSACTION_SUCCESS_FEE_ENABLED=false
PARTNER_MARKETPLACE_ENABLED=false
# LEGAL_REVIEW — consumer withdrawal + automated fiscal invoices (default OFF)
CONSUMER_WITHDRAWAL_ENABLED=false
AUTOMATED_INVOICE_ENABLED=false
INVESTOR_PRO_ENABLED=true
LISTING_BOOST_ENABLED=true
B2B_AGENT_PLANS_ENABLED=true
B2B_AGENCY_PLANS_ENABLED=true
B2B_DEVELOPER_PLANS_ENABLED=true
EXPERT_REVIEW_ENABLED=true
INVESTMENT_AUDIT_ENABLED=true

# --- Monetization ops (Phase 6 LTV/CAC) ---
# Marketing spend in haléře for last 30 days; optional override for new paying count.
MARKETING_SPEND_MINOR_30D=0
# NEW_PAYING_CUSTOMERS_30D=
# ANALYTICS_PROVIDER=console

# --- International markets (Prompt 17.1) ---
# Per-market flags: MARKET_{CODE}_{FEATURE}_ENABLED (override plugin defaults).
# MARKET_CZ_VALUATION_ENABLED=true
# MARKET_SK_VALUATION_ENABLED=false
# MARKET_ID_BALI_FOCUS_ENABLED=false

# --- Demo content (local/staging only) ---
# Production: omit or false — public discovery/detail refuse in-memory demo inventory (L-06).
# ALLOW_DEMO_PROPERTY_CONTENT=true
# Seed scripts refuse production unless ALLOW_DEMO_SEED=true (staging only). seed-test-user never runs in prod.
# ALLOW_DEMO_SEED=true
# Purge isDemo properties + test.user@majetio.local: ALLOW_PURGE_TEST_DATA=true npm run db:purge-test-data
# Retention cleanup: npm run db:cleanup-retention [-- --dry-run]
# CLEANUP_WEBHOOK_RETENTION_DAYS=90
# CLEANUP_JOB_RETENTION_DAYS=30

# --- Abuse / rate limiting (optional Upstash Redis) ---
# When unset, sliding limits fall back to in-memory; auth brute-force uses Prisma.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
